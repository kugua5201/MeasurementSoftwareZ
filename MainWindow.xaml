<hc:Window
    x:Class="MeasurementSoftware.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:MeasurementSoftware.Models"
    xmlns:ctls="clr-namespace:MeasurementSoftware.Extensions"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:MeasurementSoftware"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SF-GAMS通用自动测量系统"
    Width="1000"
    Height="600"
    Icon="/Images/ico.ico"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <hc:Window.Resources>

        <!--  主菜单按钮样式  -->
        <Style x:Key="MainMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Margin="4,2"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F0F0F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  子菜单按钮样式  -->
        <Style x:Key="SubMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="32,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Margin="4,1"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F0F0F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  带动画的 Expander 样式  -->
        <Style
            x:Key="AnimatedExpanderStyle"
            BasedOn="{StaticResource {x:Type Expander}}"
            TargetType="Expander">
            <Style.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <!--  缩放动画 - 缓慢叠上去  -->
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                    From="0.1"
                                    To="1"
                                    Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <!--  Y轴位移动画 - 向上滑入  -->
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                    From="-10"
                                    To="0"
                                    Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  GridSplitter 样式  -->
        <Style x:Key="ResizeGridSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}" Cursor="SizeWE">
                            <Rectangle
                                Width="1"
                                HorizontalAlignment="Center"
                                Fill="{DynamicResource BorderBrush}"
                                Opacity="0.5" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionIconButtonStyle" TargetType="hc:ContextMenuButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="43" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="hc:ContextMenuButton">
                        <Border x:Name="Border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E2E2E2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </hc:Window.Resources>

    <hc:Window.NonClientAreaContent>
        <Grid Height="29">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>


            <hc:ContextMenuButton
                Grid.Column="1"
                Style="{StaticResource CaptionIconButtonStyle}"
                ToolTip="设置">
                <hc:ContextMenuButton.Content>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="16"
                        Foreground="Black"
                        Text="&#xE713;" />
                </hc:ContextMenuButton.Content>
                <hc:ContextMenuButton.Menu>
                    <ContextMenu>
                        <MenuItem Command="{Binding NavigateToChannelSettingCommand}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="14"
                                        Text="&#xE762;" />
                                    <TextBlock FontSize="13" Text="通道配置" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Command="{Binding NavigateToCommunicationSettingCommand}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="14"
                                        Text="&#xE968;" />
                                    <TextBlock FontSize="13" Text="设备管理" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Command="{Binding NavigateToQrCodeSettingCommand}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="14"
                                        Text="&#xEAD8;" />
                                    <TextBlock FontSize="13" Text="二维码配置" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Command="{Binding NavigateToOtherSettingsCommand}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="14"
                                        Text="&#xE713;" />
                                    <TextBlock FontSize="13" Text="其他设置" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                </hc:ContextMenuButton.Menu>
            </hc:ContextMenuButton>
        </Grid>
    </hc:Window.NonClientAreaContent>

    <Grid Background="{DynamicResource SecondaryRegionBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                x:Name="LeftColumn"
                Width="250"
                MinWidth="200"
                MaxWidth="300" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            x:Name="GridLeft"
            Grid.Column="0"
            Margin="16,16,0,16">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="LeftTransform" X="0" />
            </Grid.RenderTransform>
            <Border Background="{DynamicResource RegionBrush}" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="10"
                        Opacity=".1"
                        ShadowDepth="0"
                        Color="{DynamicResource ShadowColor}" />
                </Border.Effect>
            </Border>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="30"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Margin="0,0,12,0" VerticalAlignment="Center">
                        <InlineUIContainer>
                            <Image
                                Width="24"
                                Height="24"
                                Source="/Images/ico.ico" />
                        </InlineUIContainer>
                    </TextBlock>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="{Binding Title}" />
                </StackPanel>

                <ScrollViewer
                    Grid.Row="1"
                    Margin="8,0,8,16"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button
                            x:Name="HomeButton"
                            Click="MenuButton_Click"
                            Command="{Binding NavigateToHomeCommand}"
                            Style="{StaticResource MainMenuButtonStyle}">
                            <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,12,0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="16"
                                    Text="&#xE80F;" />
                                <TextBlock FontSize="14" Text="测量" />
                            </StackPanel>
                        </Button>



                        <Button
                            x:Name="CalibrationButton"
                            Click="MenuButton_Click"
                            Command="{Binding NavigateToCalibrationCommand}"
                            Style="{StaticResource MainMenuButtonStyle}">
                            <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,12,0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="16"
                                    Text="&#xE9E9;" />
                                <TextBlock FontSize="14" Text="校准" />
                            </StackPanel>
                        </Button>



                        <Button
                            x:Name="SpcButton"
                            Click="MenuButton_Click"
                            Command="{Binding NavigateToSpcCommand}"
                            Style="{StaticResource MainMenuButtonStyle}">
                            <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,12,0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="16"
                                    Text="&#xE9D9;" />
                                <TextBlock FontSize="14" Text="SPC分析" />
                            </StackPanel>
                        </Button>

                        <Expander
                            x:Name="SettingsExpander"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Expanded="Expander_Expanded"
                            Header="设置"
                            Style="{StaticResource AnimatedExpanderStyle}">
                            <Expander.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleY="1" />
                                    <TranslateTransform Y="0" />
                                </TransformGroup>
                            </Expander.RenderTransform>
                            <Expander.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="16,12" Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,12,0"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="16"
                                            Text="&#xE713;" />
                                        <TextBlock FontSize="14" Text="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </Expander.HeaderTemplate>
                            <StackPanel>
                                <Button
                                    x:Name="ChannelSettingButton"
                                    Click="MenuButton_Click"
                                    Command="{Binding NavigateToChannelSettingCommand}"
                                    Style="{StaticResource SubMenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,12,0"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="14"
                                            Text="&#xE762;" />
                                        <TextBlock FontSize="13" Text="通道配置" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="CommunicationButton"
                                    Click="MenuButton_Click"
                                    Command="{Binding NavigateToCommunicationSettingCommand}"
                                    Style="{StaticResource SubMenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,12,0"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="14"
                                            Text="&#xE968;" />
                                        <TextBlock FontSize="13" Text="设备管理" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="QrCodeSettingButton"
                                    Click="MenuButton_Click"
                                    Command="{Binding NavigateToQrCodeSettingCommand}"
                                    Style="{StaticResource SubMenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,12,0"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="14"
                                            Text="&#xEAD8;" />
                                        <TextBlock FontSize="13" Text="二维码配置" />
                                    </StackPanel>
                                </Button>
                                <!--<Button
                                    x:Name="MesSettingButton"
                                    Click="MenuButton_Click"
                                    Command="{Binding NavigateToMesSettingCommand}"
                                    Style="{StaticResource SubMenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,12,0"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="14"
                                            Text="&#xE774;" />
                                        <TextBlock FontSize="13" Text="MES配置" />
                                    </StackPanel>
                                </Button>-->
                                <Button
                                    x:Name="OtherSettingsButton"
                                    Click="MenuButton_Click"
                                    Command="{Binding NavigateToOtherSettingsCommand}"
                                    Style="{StaticResource SubMenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,12,0"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="14"
                                            Text="&#xE713;" />
                                        <TextBlock FontSize="13" Text="其他设置" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>



                        <Button
                            x:Name="RecipeManagementButton"
                            Click="MenuButton_Click"
                            Command="{Binding NavigateToRecipeManagementCommand}"
                            Style="{StaticResource MainMenuButtonStyle}">
                            <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,12,0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="16"
                                    Text="&#xE7C3;" />
                                <TextBlock FontSize="14" Text="配方管理" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="DataManagementButton"
                            Click="MenuButton_Click"
                            Command="{Binding NavigateToDataManagementCommand}"
                            Style="{StaticResource MainMenuButtonStyle}">
                            <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,12,0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="16"
                                    Text="&#xE8F1;" />
                                <TextBlock FontSize="14" Text="检测记录" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="LogViewerButton"
                            Click="MenuButton_Click"
                            Command="{Binding NavigateToLogViewerCommand}"
                            Style="{StaticResource MainMenuButtonStyle}">
                            <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,12,0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="16"
                                    Text="&#xE7BA;" />
                                <TextBlock FontSize="14" Text="日志" />
                            </StackPanel>
                        </Button>


                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!--  GridSplitter 用于拖拽调整左侧菜单宽度  -->
        <GridSplitter
            Grid.Column="1"
            Width="4"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            DragCompleted="GridSplitter_DragCompleted"
            Style="{StaticResource ResizeGridSplitterStyle}" />

        <Button
            x:Name="ButtonShiftOut"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Width="15"
            Height="30"
            Margin="0,30,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{DynamicResource RegionBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,1,1"
            Click="OnLeftMainContentShiftOut">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="0,15,15,0">
                        <Path
                            Width="8"
                            Height="8"
                            HorizontalAlignment="Center"
                            Data="{StaticResource LeftGeometry}"
                            Fill="{DynamicResource PrimaryTextBrush}"
                            Stretch="Uniform" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button
            x:Name="ButtonShiftIn"
            Grid.ColumnSpan="3"
            Width="15"
            Height="30"
            Margin="0,30,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{DynamicResource RegionBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,1,1"
            Click="OnLeftMainContentShiftIn"
            Visibility="Collapsed">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="0,15,15,0">
                        <Path
                            Width="8"
                            Height="8"
                            HorizontalAlignment="Center"
                            Data="{StaticResource RightGeometry}"
                            Fill="{DynamicResource PrimaryTextBrush}"
                            Stretch="Uniform" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Border
            x:Name="MainContent"
            Grid.Column="2"
            Margin="20,16,16,16"
            Background="{DynamicResource RegionBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1,0,0,0"
            CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />

                </Grid.RowDefinitions>

                <hc:TabControl
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource RegionBrush}"
                    BorderThickness="1"
                    FontSize="12"
                    IsAnimationEnabled="True"
                    IsDraggable="True"
                    ItemsSource="{Binding Tabs}"
                    OverflowMenuDisplayMemberPath="Header"
                    PreviewMouseRightButtonDown="TabControl_PreviewMouseRightButtonDown"
                    SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                    SelectionChanged="TabControl_SelectionChanged"
                    ShowCloseButton="True"
                    TabItemWidth="120">

                    <!--  定义资源  -->
                    <hc:TabControl.Resources>
                        <!--  AntDesign 模板  -->
                        <DataTemplate x:Key="AntDesignIconTemplate">
                            <TextBlock
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SystemIconFont}"
                                FontSize="14"
                                Text="{Binding Icon}" />
                        </DataTemplate>

                        <!--  FontAwesome 模板  -->
                        <DataTemplate x:Key="FontawesomeIconTemplate">
                            <ctls:FontAwesomeIcon
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Icon="{Binding Icon}" />
                        </DataTemplate>

                        <Style
                            x:Key="CusTabItemPlusBaseStyle"
                            BasedOn="{StaticResource TabItemPlusBaseStyle}"
                            TargetType="hc:TabItem">
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                            <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="hc:TabItem">
                                        <Grid
                                            x:Name="templateRoot"
                                            ContextMenu="{TemplateBinding Menu}"
                                            SnapsToDevicePixels="true">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!--  外层边框  -->
                                            <Border
                                                x:Name="mainBorder"
                                                Grid.ColumnSpan="3"
                                                Margin="0"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                <Border
                                                    x:Name="innerBorder"
                                                    Margin="0,0,0,-1"
                                                    Background="{DynamicResource RegionBrush}"
                                                    Visibility="Collapsed" />
                                            </Border>

                                            <!--  图标  -->
                                            <Path
                                                x:Name="PathMain"
                                                Grid.Column="0"
                                                Width="{TemplateBinding hc:IconElement.Width}"
                                                Height="{TemplateBinding hc:IconElement.Height}"
                                                Margin="10,0,0,0"
                                                Data="{TemplateBinding hc:IconElement.Geometry}"
                                                Fill="{TemplateBinding Foreground}"
                                                SnapsToDevicePixels="True"
                                                Stretch="Uniform" />

                                            <!--  Header 内容  -->
                                            <ContentPresenter
                                                x:Name="contentPresenter"
                                                Grid.Column="1"
                                                Margin="{TemplateBinding Padding}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                ContentSource="Header"
                                                Focusable="False"
                                                RecognizesAccessKey="True"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                                            <!--  遮罩  -->
                                            <Border
                                                Name="BorderMask"
                                                Grid.Column="1"
                                                Width="20"
                                                Margin="0,0,1,1"
                                                HorizontalAlignment="Right"
                                                Background="{TemplateBinding Background}">
                                                <Border.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Offset="1" Color="White" />
                                                        <GradientStop Offset="0" />
                                                    </LinearGradientBrush>
                                                </Border.OpacityMask>
                                            </Border>

                                            <!--  关闭按钮  -->
                                            <Button
                                                Grid.Column="2"
                                                Width="28"
                                                Background="Transparent"
                                                Command="{Binding CloseTabCommand}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Focusable="False"
                                                OverridesDefaultStyle="True"
                                                Visibility="{Binding IsClosable, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <!--  使用稍大的容器保证圆形和图标居中  -->
                                                        <Grid
                                                            Width="28"
                                                            Height="28"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Opacity="1">
                                                            <!--  圆形 hover 背景（默认透明）  -->
                                                            <Ellipse
                                                                x:Name="bg"
                                                                Width="16"
                                                                Height="16"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Fill="Transparent" />
                                                            <Path
                                                                x:Name="icon"
                                                                Width="8"
                                                                Height="8"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Fill="{DynamicResource PrimaryTextBrush}"
                                                                SnapsToDevicePixels="True"
                                                                Style="{StaticResource ClosePathStyle}" />
                                                        </Grid>

                                                        <ControlTemplate.Triggers>
                                                            <!--  Hover：显示圆形背景并加深图标颜色  -->
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Fill" Value="#E5E5E5" />
                                                                <Setter TargetName="icon" Property="Fill" Value="#333" />
                                                            </Trigger>

                                                            <!--  Pressed：背景更深  -->
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="bg" Property="Fill" Value="#CCCCCC" />
                                                            </Trigger>

                                                            <!--  Disabled 状态下淡化（可选）  -->
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="icon" Property="Opacity" Value="0.4" />
                                                                <Setter TargetName="bg" Property="Opacity" Value="0.4" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="true">
                                                <Setter Property="Panel.ZIndex" Value="1" />
                                                <Setter TargetName="innerBorder" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter TargetName="BorderMask" Property="Background" Value="{DynamicResource RegionBrush}" />
                                            </Trigger>

                                            <Trigger Property="hc:IconElement.Geometry" Value="{x:Null}">
                                                <Setter TargetName="PathMain" Property="Visibility" Value="Collapsed" />
                                            </Trigger>

                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="contentPresenter" Property="Opacity" Value="0.4" />
                                            </Trigger>

                                            <!--  Hover 效果  -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <!--<Setter Property="Background" TargetName="mainBorder" Value="{DynamicResource SecondaryRegionBrush}" />-->
                                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="{DynamicResource PrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                    </hc:TabControl.Resources>

                    <hc:TabControl.ItemContainerStyle>
                        <Style BasedOn="{StaticResource CusTabItemPlusBaseStyle}" TargetType="hc:TabItem">
                            <Setter Property="Menu">
                                <Setter.Value>
                                    <ContextMenu
                                        MinWidth="140"
                                        Padding="3,5"
                                        Background="{DynamicResource ThirdlyRegionBrush}">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="MenuItem">
                                                            <Border
                                                                x:Name="Border"
                                                                Padding="0,5"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="2">
                                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" ContentSource="Header" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsHighlighted" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextIconBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Opacity" Value="0.4" />
                                                                    <Setter Property="Cursor" Value="No" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                        <MenuItem
                                            Command="{Binding PlacementTarget.DataContext.RefreshTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            Header="刷新页面" />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            Header="关闭当前"
                                            IsEnabled="{Binding PlacementTarget.DataContext.IsClosable, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.DataContext.CloseLeftTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            Header="关闭左侧"
                                            IsEnabled="{Binding PlacementTarget.DataContext.HasClosableLeft, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.DataContext.CloseRightTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            Header="关闭右侧"
                                            IsEnabled="{Binding PlacementTarget.DataContext.HasClosableRight, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.DataContext.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            Header="关闭其他"
                                            IsEnabled="{Binding PlacementTarget.DataContext.HasClosableOther, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.DataContext.CloseAllTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            Header="关闭全部"
                                            IsEnabled="{Binding PlacementTarget.DataContext.HasClosableAny, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </hc:TabControl.ItemContainerStyle>

                    <hc:TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                                <!--  ContentControl：动态选择图标模板  -->
                                <ContentControl>
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <!--  默认模板（AntDesign）  -->
                                            <Setter Property="ContentTemplate" Value="{StaticResource AntDesignIconTemplate}" />
                                            <!--  绑定数据上下文  -->
                                            <Setter Property="Content" Value="{Binding}" />
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                                <!--  文本标题  -->
                                <TextBlock VerticalAlignment="Center" Text="{Binding Header}" />

                            </StackPanel>
                        </DataTemplate>
                    </hc:TabControl.ItemTemplate>

                    <!--  内容模板绑定到 TabItemModel.Content  -->
                    <hc:TabControl.ContentTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Content}" />
                        </DataTemplate>
                    </hc:TabControl.ContentTemplate>
                </hc:TabControl>

            </Grid>
        </Border>

        <Border
            Grid.ColumnSpan="3"
            Panel.ZIndex="999"
            d:Visibility="Collapsed"
            Background="#66000000"
            Visibility="{Binding IsAppLoading, Converter={StaticResource Boolean2VisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border
                    Padding="28,24"
                    Background="{DynamicResource RegionBrush}"
                    CornerRadius="12">
                    <StackPanel HorizontalAlignment="Center">
                        <hc:LoadingCircle
                            Width="56"
                            Height="56"
                            Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="{Binding AppLoadingMessage}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</hc:Window>