<Window
    x:Class="MeasurementSoftware.Windows.ChannelTrendWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    Title="通道趋势图"
    Width="980"
    Height="620"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock
                    FontSize="12"
                    Foreground="#666"
                    Text="通道" />
                <TextBlock
                    x:Name="ChannelNameTextBlock"
                    FontSize="15"
                    FontWeight="Bold" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock
                    FontSize="12"
                    Foreground="#666"
                    Text="原始值" />
                <TextBlock
                    x:Name="PlcValueTextBlock"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="#1E88E5" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock
                    FontSize="12"
                    Foreground="#666"
                    Text="置零值" />
                <TextBlock
                    x:Name="ZeroedValueTextBlock"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="#FB8C00" />
            </StackPanel>

            <StackPanel Grid.Column="3">
                <TextBlock
                    FontSize="12"
                    Foreground="#666"
                    Text="当前点" />
                <TextBlock
                    x:Name="HoverInfoTextBlock"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="#444"
                    Text="--" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            BorderBrush="#DDD"
            BorderThickness="1"
            CornerRadius="6">
            <scottPlot:WpfPlot
                x:Name="TrendPlot"
                MouseLeave="TrendPlot_MouseLeave"
                MouseMove="TrendPlot_MouseMove" />
        </Border>
    </Grid>
</Window>