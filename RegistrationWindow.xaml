<hc:Window x:Class="MeasurementSoftware.RegistrationWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           mc:Ignorable="d"
           Title="软件注册"
           Width="520"
           Height="280"
           ResizeMode="NoResize"
           WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="机器码" FontSize="14" FontWeight="SemiBold"/>

        <Grid Grid.Row="1" Margin="0,10,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MachineCodeTextBox"
                     Height="36"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center"/>
            <Button Grid.Column="1"
                    Margin="12,0,0,0"
                    Padding="16,0"
                    Click="CopyMachineCodeButton_Click"
                    Content="复制"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="授权码" FontSize="14" FontWeight="SemiBold"/>

        <TextBox x:Name="LicenseKeyTextBox"
                 Grid.Row="3"
                 Height="36"
                 Margin="0,10,0,0"
                 VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="4"
                   Margin="0,12,0,0"
                   Foreground="#D13438"
                   Text="未注册状态下，软件每隔 1 小时会停止一次当前采集。"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="5"
                    Margin="0,20,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="88" Height="32" Margin="0,0,12,0" IsCancel="True" Content="取消"/>
            <Button Width="88" Height="32" IsDefault="True" Click="RegisterButton_Click" Content="注册"/>
        </StackPanel>
    </Grid>
</hc:Window>
