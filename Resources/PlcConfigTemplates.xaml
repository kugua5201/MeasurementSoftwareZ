<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:MeasurementSoftware.Converters"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helpers="clr-namespace:MeasurementSoftware.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors">

    <!--
        WPF 限制：MergedDictionaries 同级字典在解析阶段互不可见，
        因此本文件必须自行合并所依赖的字典，StaticResource 才能正常解析。
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="GlobalSizes.xaml" />
        <ResourceDictionary Source="GlobalConverters.xaml" />
        <ResourceDictionary Source="GlobalEnumSources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:PlcConfigTemplateSelector x:Key="PlcConfigTemplateSelector">

        <!--  ===== 西门子 S7 =====  -->
        <converters:PlcConfigTemplateSelector.SiemensS7Template>
            <DataTemplate>
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Text="西门子 S7 通讯参数" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource FormGridWidthWide}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,0,8"
                            VerticalAlignment="Center"
                            Text="IP 地址：" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="{StaticResource PlcFieldInputWidth}"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            hc:InfoElement.Placeholder="例如：192.168.0.1"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,0,8"
                            VerticalAlignment="Center"
                            Text="端口：" />
                        <hc:NumericUpDown
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="{StaticResource PlcFieldInputWidth}"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            Maximum="65535"
                            Minimum="1"
                            Value="{Binding Port}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,0,0,8"
                            VerticalAlignment="Center"
                            Text="机架号：" />
                        <hc:NumericUpDown
                            Grid.Row="2"
                            Grid.Column="1"
                            Width="{StaticResource PlcFieldInputWidth}"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            Maximum="15"
                            Minimum="0"
                            Value="{Binding Rack}" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="槽号：" />
                        <hc:NumericUpDown
                            Grid.Row="3"
                            Grid.Column="1"
                            Width="{StaticResource PlcFieldInputWidth}"
                            HorizontalAlignment="Left"
                            Maximum="31"
                            Minimum="0"
                            Value="{Binding Slot}" />
                    </Grid>
                </StackPanel>
            </DataTemplate>
        </converters:PlcConfigTemplateSelector.SiemensS7Template>

