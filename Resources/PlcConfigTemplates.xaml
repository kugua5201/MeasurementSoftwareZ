                                    Grid.Column="1"
                                    Width="180"
                                    HorizontalAlignment="Left"
                                    Maximum="9999999"
                                    Minimum="1"
                                    Value="{Binding SiemensReadCache.MaxCacheCount, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <!--  操作按钮  -->
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <Button
                                    Margin="0,0,8,0"
                                    Padding="12,4"
                                    Command="{Binding DataContext.ApplyCachePointsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Content="验证并生成"
                                    Style="{StaticResource ButtonPrimary}" />
                            </StackPanel>
                            <!--<TextBlock Text="{Binding SiemensReadCache.StructureValidationMessage}" FontSize="12" Margin="0,4,0,0"/>-->
                            <!--<TextBlock FontSize="11" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                        <Setter Property="Text" Value="● 已生成点位后会立即尝试启动缓存读取；若“缓存值”列为空，请检查设备连接、可读标志地址、DB块、长度和结构定义。"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCacheReading}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                <Setter Property="Text" Value="● 缓存读取中；下表会实时显示缓存值，并在说明列展示对应点位和绑定通道。"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>-->

                            <!--  已验证字段预览（实时显示缓存值和说明）  -->
                            <DataGrid
                                x:Name="CacheFieldGrid1200"
                                MinHeight="50"
                                MaxHeight="300"
                                Margin="0,8,0,0"
                                AutoGenerateColumns="False"
                                Background="White"
                                BorderBrush="{DynamicResource BorderBrush}"
                                CanUserAddRows="False"
                                FontSize="12"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                ItemsSource="{Binding SiemensReadCache.ExpandedFieldDefinitions}"
                                RowHeight="28"
                                SelectionMode="Single"
                                Visibility="{Binding SiemensReadCache.IsStructureValid, Converter={StaticResource Boolean2VisibilityConverter}}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding DataContext.OpenCacheFieldPointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding SelectedItem, ElementName=CacheFieldGrid1200}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="150"
                                        Binding="{Binding DisplayName}"
                                        Header="字段名" />
                                    <DataGridTextColumn
                                        Width="100"
                                        Binding="{Binding DataType}"
                                        Header="类型" />
                                    <DataGridTextColumn
                                        Width="100"
                                        Binding="{Binding ByteOrder}"
                                        Header="字节序" />
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Description}"
                                        Header="说明" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </converters:PlcConfigTemplateSelector.SiemensS71200Template>

