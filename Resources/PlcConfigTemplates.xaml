                                    hc:InfoElement.Placeholder="例如：DB1.DBX0.0"
                                    Style="{StaticResource TextBoxExtend}"
                                    Text="{Binding SiemensReadCache.Cache1.ReadableFlagAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  缓存区 2  -->
                    <Border
                        Margin="0,8,0,0"
                        Padding="12,8"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        IsEnabled="{Binding SiemensReadCache.IsEnabled}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="缓存区 2" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource FormGridWidthWide}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,0,8"
                                    VerticalAlignment="Center"
                                    Text="DB 块：" />
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="{StaticResource PlcFieldInputWidth}"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    hc:InfoElement.Placeholder="例如：DB11"
                                    Style="{StaticResource TextBoxExtend}"
                                    Text="{Binding SiemensReadCache.Cache2.DbBlock, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,0,8"
                                    VerticalAlignment="Center"
                                    Text="长度地址：" />
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Width="{StaticResource PlcFieldInputWidth}"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    hc:InfoElement.Placeholder="例如：MW58"
                                    Style="{StaticResource TextBoxExtend}"
                                    Text="{Binding SiemensReadCache.Cache2.LengthAddress, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="可读标志地址：" />
                                <TextBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Width="{StaticResource PlcFieldInputWidth}"
                                    HorizontalAlignment="Left"
                                    hc:InfoElement.Placeholder="例如：DB1.DBX0.1"
                                    Style="{StaticResource TextBoxExtend}"
                                    Text="{Binding SiemensReadCache.Cache2.ReadableFlagAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  缓存数据结构定义  -->
                    <Border
                        Margin="0,8,0,0"
                        Padding="12,8"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        IsEnabled="{Binding SiemensReadCache.IsEnabled}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="缓存数据结构定义（两个缓存共用）" />
                            <TextBlock
                                Margin="0,0,0,2"
                                FontSize="11"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="每行一个字段，格式：字段名:数据类型[:字节序]，偏移自动计算" />
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="10"
                                Foreground="{DynamicResource ThirdTextBrush}"
                                Text="类型：Bool, Byte, Int16, UInt16, Int32, UInt32, Float, Double, String  字节序：ABCD, BADC, CDAB, DCBA"
                                TextWrapping="Wrap" />

                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="是否解析X值：" />
                                <ToggleButton IsChecked="{Binding SiemensReadCache.EnableXValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToggleButtonSwitch}" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Text="默认添加 X，解析 Y；禁用后不解析X，全部作为 Y。" />
                            </StackPanel>

                            <TextBox
                                MinHeight="80"
                                MaxHeight="180"
                                hc:InfoElement.Placeholder="时间戳:Double:DCBA&#x0a;测量值1:Float:DCBA&#x0a;测量值2:Float:DCBA"
                                AcceptsReturn="True"
                                FontFamily="Consolas"
                                FontSize="12"
                                Style="{StaticResource TextBoxExtend}"
                                Text="{Binding SiemensReadCache.StructureDefinitionText, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />

                            <!--  操作按钮  -->
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <Button
                                    Margin="0,0,8,0"
                                    Padding="12,4"
                                    Command="{Binding DataContext.ApplyCachePointsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Content="验证并生成"
                                    Style="{StaticResource ButtonPrimary}" />
                            </StackPanel>
                            <!--<TextBlock Text="{Binding SiemensReadCache.StructureValidationMessage}" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock FontSize="11" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                        <Setter Property="Text" Value="● 已生成点位后会立即尝试启动缓存读取；若“缓存值”列为空，请检查设备连接、可读标志地址、DB块、长度和结构定义。"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCacheReading}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                <Setter Property="Text" Value="● 缓存读取中；下表会实时显示缓存值，并在说明列展示对应点位和绑定通道。"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>-->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource FormGridWidthWide}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="最大缓存数量：" />
                                <hc:NumericUpDown
                                    Grid.Column="1"
                                    Width="180"
                                    HorizontalAlignment="Left"
                                    Maximum="9999999"
                                    Minimum="1"
                                    Value="{Binding SiemensReadCache.MaxCacheCount, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <!--  已验证字段预览（实时显示缓存值和说明）  -->
                            <DataGrid
                                x:Name="CacheFieldGrid1500"
                                MinHeight="50"
                                MaxHeight="300"
                                Margin="0,8,0,0"
                                AutoGenerateColumns="False"
                                Background="White"
                                BorderBrush="{DynamicResource BorderBrush}"
                                CanUserAddRows="False"
                                FontSize="12"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                ItemsSource="{Binding SiemensReadCache.ExpandedFieldDefinitions}"
                                RowHeight="28"
                                SelectionMode="Single"
                                Visibility="{Binding SiemensReadCache.IsStructureValid, Converter={StaticResource Boolean2VisibilityConverter}}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding DataContext.OpenCacheFieldPointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding SelectedItem, ElementName=CacheFieldGrid1500}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="150"
                                        Binding="{Binding DisplayName}"
                                        Header="字段名" />
                                    <DataGridTextColumn
                                        Width="100"
                                        Binding="{Binding DataType}"
                                        Header="类型" />
                                    <DataGridTextColumn
                                        Width="100"
                                        Binding="{Binding ByteOrder}"
                                        Header="字节序" />
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Description}"
                                        Header="说明" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </converters:PlcConfigTemplateSelector.SiemensS71500Template>

        <!--  ===== 三菱 MC =====  -->
        <converters:PlcConfigTemplateSelector.MitsubishiMCTemplate>
            <DataTemplate>
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="{DynamicResource SuccessBrush}"
                        Text="三菱 MC 通讯参数" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource FormGridWidthWide}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,0,8"
                            VerticalAlignment="Center"
                            Text="IP 地址：" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="{StaticResource PlcFieldInputWidth}"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            hc:InfoElement.Placeholder="例如：192.168.0.1"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="端口：" />
                        <hc:NumericUpDown
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="{StaticResource PlcFieldInputWidth}"
                            HorizontalAlignment="Left"
                            Maximum="65535"
                            Minimum="1"
                            Value="{Binding Port}" />
                    </Grid>
                </StackPanel>
            </DataTemplate>
        </converters:PlcConfigTemplateSelector.MitsubishiMCTemplate>

        <!--  ===== Modbus TCP =====  -->
        <converters:PlcConfigTemplateSelector.ModbusTCPTemplate>
            <DataTemplate>
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="{DynamicResource WarningBrush}"
                        Text="Modbus TCP 通讯参数" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource FormGridWidthWide}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,0,8"
                            VerticalAlignment="Center"
                            Text="IP 地址：" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="{StaticResource PlcFieldInputWidth}"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            hc:InfoElement.Placeholder="例如：192.168.0.1"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,0,8"
                            VerticalAlignment="Center"
                            Text="端口：" />
                        <hc:NumericUpDown
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="{StaticResource PlcFieldInputWidth}"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            Maximum="65535"
                            Minimum="1"
                            Value="{Binding Port}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,0,0,8"
                            VerticalAlignment="Center"
                            Text="从站地址：" />
                        <hc:NumericUpDown
                            Grid.Row="2"
                            Grid.Column="1"
                            Width="{StaticResource PlcFieldInputWidth}"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            Maximum="247"
                            Minimum="1"
                            Value="{Binding SlaveAddress}" />


                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="首地址从0开始：" />
                        <ToggleButton
                            Grid.Row="3"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            IsChecked="{Binding AddressStartWithZero}"
                            Style="{StaticResource ToggleButtonSwitch}" />
                    </Grid>
                </StackPanel>
            </DataTemplate>
        </converters:PlcConfigTemplateSelector.ModbusTCPTemplate>

        <!--  ===== Modbus RTU =====  -->
        <converters:PlcConfigTemplateSelector.ModbusRTUTemplate>
            <DataTemplate>
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="{DynamicResource DangerBrush}"
                        Text="Modbus RTU 通讯参数" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource FormGridWidthWide}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  COM口 + 刷新  -->
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,0,8"
                            VerticalAlignment="Center"
                            Text="COM 口：" />
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            Orientation="Horizontal">
                            <ComboBox
                                Width="{StaticResource PlcFieldInputWidth}"
                                VerticalAlignment="Center"
                                hc:InfoElement.Placeholder="请选择串口"
                                IsEditable="False"
                                ItemsSource="{Binding DataContext.AvailableComPorts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                SelectedItem="{Binding ComPort, Mode=TwoWay}"
                                Style="{StaticResource ComboBoxExtend}" />
                            <Button
                                Width="30"
                                Height="30"
                                Margin="8,0,0,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Command="{Binding DataContext.RefreshComPortsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Cursor="Hand"
                                Style="{StaticResource ButtonDefault}"
                                ToolTip="刷新串口列表">
                                <Path
                                    Width="14"
                                    Height="14"
                                    Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                    Fill="{DynamicResource PrimaryTextBrush}"
                                    Stretch="Uniform" />
                            </Button>
                        </StackPanel>

                        <!--  波特率  -->
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,0,8"
                            VerticalAlignment="Center"
                            Text="波特率：" />
                        <ComboBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="{StaticResource PlcFieldInputWidth}"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding Source={StaticResource BaudRateValues}}"
                            SelectedItem="{Binding BaudRate, Mode=TwoWay}"
                            Style="{StaticResource ComboBoxExtend}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayTextConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!--  数据位  -->
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,0,0,8"
                            VerticalAlignment="Center"
                            Text="数据位：" />
                        <ComboBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Width="{StaticResource PlcFieldInputWidth}"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding Source={StaticResource DataBitsValues}}"
                            SelectedItem="{Binding DataBits, Mode=TwoWay}"
                            Style="{StaticResource ComboBoxExtend}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayTextConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!--  停止位  -->
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,0,0,8"
                            VerticalAlignment="Center"
                            Text="停止位：" />
                        <ComboBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Width="{StaticResource PlcFieldInputWidth}"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding Source={StaticResource StopBitsValues}}"
                            SelectedItem="{Binding StopBits, Mode=TwoWay}"
                            Style="{StaticResource ComboBoxExtend}" />

                        <!--  校验位  -->
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="0,0,0,8"
                            VerticalAlignment="Center"
                            Text="校验位：" />
                        <ComboBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Width="{StaticResource PlcFieldInputWidth}"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding Source={StaticResource ParityValues}}"
                            SelectedItem="{Binding Parity, Mode=TwoWay}"
                            Style="{StaticResource ComboBoxExtend}" />

                        <!--  从站地址  -->
                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            Margin="0,0,0,8"
                            VerticalAlignment="Center"
                            Text="从站地址：" />
                        <hc:NumericUpDown
                            Grid.Row="5"
                            Grid.Column="1"
                            Width="{StaticResource PlcFieldInputWidth}"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            Maximum="247"
                            Minimum="1"
                            Value="{Binding SlaveAddress}" />


                        <TextBlock
                            Grid.Row="6"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="首地址从0开始：" />
                        <ToggleButton
                            Grid.Row="6"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            IsChecked="{Binding AddressStartWithZero}"
                            Style="{StaticResource ToggleButtonSwitch}" />
                    </Grid>
                </StackPanel>
            </DataTemplate>
        </converters:PlcConfigTemplateSelector.ModbusRTUTemplate>

    </converters:PlcConfigTemplateSelector>

</ResourceDictionary>
