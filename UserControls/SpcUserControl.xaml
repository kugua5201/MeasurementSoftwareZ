<UserControl
    x:Class="MeasurementSoftware.UserControls.SpcUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:MeasurementSoftware.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    d:DesignHeight="704"
    d:DesignWidth="1139.333"
    mc:Ignorable="d">

    <Grid Style="{StaticResource PageRootGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶部操作栏  -->
        <Border Grid.Row="0" Style="{StaticResource PageToolbarBorder}">
            <WrapPanel HorizontalAlignment="Left">
                <TextBlock
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Text="通道：" />
                <ComboBox
                    Width="150"
                    Margin="0,0,15,0"
                    DisplayMemberPath="ChannelName"
                    ItemsSource="{Binding Channels}"
                    SelectedItem="{Binding SelectedChannel}"
                    Style="{StaticResource ComboBoxExtend}" />

                <TextBlock
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Text="起始日期：" />
                <hc:DatePicker
                    Width="130"
                    Margin="0,0,15,0"
                    SelectedDate="{Binding StartDate}" />

                <TextBlock
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Text="结束日期：" />
                <hc:DatePicker
                    Width="130"
                    Margin="0,0,5,0"
                    SelectedDate="{Binding EndDate}" />

                <TextBlock
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Text="子组大小：" />
                <hc:NumericUpDown
                    Width="80"
                    Margin="0,0,5,0"
                    Maximum="10"
                    Minimum="2"
                    Value="{Binding SubgroupSize}" />

                <Button
                    Width="{StaticResource FormButtonWidth}"
                    Margin="0,0,5,0"
                    Command="{Binding AnalyzeCommand}"
                    Content="分析"
                    Style="{StaticResource ButtonPrimary}" />
                <Button
                    Width="{StaticResource FormButtonWidth}"
                    Command="{Binding ClearResultsCommand}"
                    Content="清除"
                    Style="{StaticResource ButtonDefault}" />
            </WrapPanel>
        </Border>

        <!--  主内容区  -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="300"
                    MinWidth="240"
                    MaxWidth="520" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧：SPC指标面板  -->
            <Border
                Grid.Column="0"
                Background="White"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Effect="{StaticResource EffectShadow1}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="12"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="6,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="&#xE9D9;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="Bold"
                                Text="SPC指标" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer
                        Grid.Row="1"
                        Margin="15"
                        VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" MinHeight="160" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" MinHeight="180" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Padding="12"
                                Background="{DynamicResource BackgroundColor}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Text="过程能力" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,0,8">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="Cp" />
                                            <TextBlock
                                                FontSize="18"
                                                FontWeight="Bold"
                                                Text="{Binding CurrentSpcResult.Cp, StringFormat='{}{0:F3}', FallbackValue='--'}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="0,0,0,8">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="Cpk" />
                                            <TextBlock
                                                FontSize="18"
                                                FontWeight="Bold"
                                                Text="{Binding CurrentSpcResult.Cpk, StringFormat='{}{0:F3}', FallbackValue='--'}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,0,0,8">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="合格率" />
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource StatusSuccessBrush}"
                                                Text="{Binding CurrentSpcResult.YieldRate, StringFormat='{}{0:F1}%', FallbackValue='--'}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,0,0,8">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="等级" />
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Text="{Binding CurrentSpcResult.CpkLevel, FallbackValue='--'}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="样本数" />
                                            <TextBlock FontSize="14" Text="{Binding CurrentSpcResult.SampleCount, FallbackValue='--'}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="标准差" />
                                            <TextBlock FontSize="14" Text="{Binding CurrentSpcResult.StdDev, StringFormat='{}{0:F6}', FallbackValue='--'}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Row="2"
                                Padding="12"
                                Background="{DynamicResource BackgroundColor}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Text="统计信息" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,0,6">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="均值" />
                                            <TextBlock FontSize="13" Text="{Binding CurrentSpcResult.Mean, StringFormat='{}{0:F4}', FallbackValue='--'}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="0,0,0,6">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="极差" />
                                            <TextBlock FontSize="13" Text="{Binding CurrentSpcResult.Range, StringFormat='{}{0:F4}', FallbackValue='--'}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,0,0,6">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="最大值" />
                                            <TextBlock FontSize="13" Text="{Binding CurrentSpcResult.Max, StringFormat='{}{0:F4}', FallbackValue='--'}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,0,0,6">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="最小值" />
                                            <TextBlock FontSize="13" Text="{Binding CurrentSpcResult.Min, StringFormat='{}{0:F4}', FallbackValue='--'}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Margin="0,0,0,6">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="USL" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{StaticResource StatusErrorBrush}"
                                                Text="{Binding CurrentSpcResult.USL, StringFormat='{}{0:F4}', FallbackValue='--'}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Margin="0,0,0,6">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="LSL" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{StaticResource StatusErrorBrush}"
                                                Text="{Binding CurrentSpcResult.LSL, StringFormat='{}{0:F4}', FallbackValue='--'}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="标准值" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{StaticResource StatusInfoBrush}"
                                                Text="{Binding CurrentSpcResult.Nominal, StringFormat='{}{0:F4}', FallbackValue='--'}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>



                            <Border
                                Grid.Row="4"
                                Padding="12"
                                Background="{DynamicResource BackgroundColor}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0,0,0,8"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Text="通道对比" />
                                    <DataGrid
                                        Grid.Row="1"
                                        AutoGenerateColumns="False"
                                        BorderThickness="0"
                                        CanUserResizeColumns="False"
                                        GridLinesVisibility="Horizontal"
                                        HeadersVisibility="Column"
                                        HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding SpcResults}"
                                        RowHeight="32">

                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="100"
                                                Binding="{Binding ChannelName}"
                                                Header="通道" />
                                            <DataGridTextColumn
                                                Width="100"
                                                Binding="{Binding Cpk, StringFormat=F3}"
                                                Header="Cpk" />
                                            <DataGridTextColumn
                                                Width="100"
                                                Binding="{Binding YieldRate, StringFormat='{}{0:F1}%'}"
                                                Header="合格率" />
                                            <DataGridTextColumn
                                                Width="100"
                                                Binding="{Binding CpkLevel}"
                                                Header="等级" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
            <GridSplitter
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                Cursor="SizeWE"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns"
                ShowsPreview="False" />
            <!--  右侧：图表区域  -->
            <Border
                Grid.Column="2"
                Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Effect="{StaticResource EffectShadow1}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="12"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="6,6,0,0">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Bold"
                            Text="SPC控制图" />
                    </Border>

                    <Grid
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="10"
                        IsEnabled="{Binding HasAnalysisResult}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <hc:TabControl
                            Grid.Row="0"
                            HorizontalAlignment="Left"
                            BorderThickness="0"
                            SelectedIndex="{Binding SelectedChartTabIndex, Mode=TwoWay}"
                            Style="{StaticResource TabControlCapsuleSolid}">
                            <hc:TabItem Header="Xbar 控制图" />
                            <hc:TabItem Header="R 控制图" />
                            <hc:TabItem Header="直方图" />
                            <hc:TabItem Header="数据趋势" />
                        </hc:TabControl>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedChartTabIndex}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <scottPlot:WpfPlot Margin="5">
                                    <i:Interaction.Behaviors>
                                        <behaviors:ScottPlotChartBehavior ChartModel="{Binding XbarChartModel}" />
                                    </i:Interaction.Behaviors>
                                </scottPlot:WpfPlot>
                            </Border>

                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedChartTabIndex}" Value="1">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <scottPlot:WpfPlot Margin="5">
                                    <i:Interaction.Behaviors>
                                        <behaviors:ScottPlotChartBehavior ChartModel="{Binding RChartModel}" />
                                    </i:Interaction.Behaviors>
                                </scottPlot:WpfPlot>
                            </Border>

                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedChartTabIndex}" Value="2">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <scottPlot:WpfPlot Margin="5">
                                    <i:Interaction.Behaviors>
                                        <behaviors:ScottPlotChartBehavior ChartModel="{Binding HistogramChartModel}" />
                                    </i:Interaction.Behaviors>
                                </scottPlot:WpfPlot>
                            </Border>

                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedChartTabIndex}" Value="3">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <scottPlot:WpfPlot Margin="5">
                                    <i:Interaction.Behaviors>
                                        <behaviors:ScottPlotChartBehavior ChartModel="{Binding TrendChartModel}" />
                                    </i:Interaction.Behaviors>
                                </scottPlot:WpfPlot>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
