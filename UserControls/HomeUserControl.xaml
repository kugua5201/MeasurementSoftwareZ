    </UserControl.Resources>-->
    <Grid Style="{StaticResource PageRootGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶部工具栏  -->
        <Border Grid.Row="0" Style="{StaticResource PageToolbarBorder}">
            <Grid>
                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <Button
                        Width="{StaticResource FormLabelWidth}"
                        Margin="0,0,5,0"
                        Command="{Binding StartAcquisitionCommand}"
                        Content="启动测量"
                        Style="{StaticResource ButtonSuccess}" />
                    <Button
                        Width="{StaticResource FormLabelWidth}"
                        Margin="0,0,5,0"
                        Command="{Binding CompleteMeasurementCommand}"
                        Content="完成测量"
                        Style="{StaticResource ButtonSuccess}" />
                    <Button
                        Width="{StaticResource FormLabelWidth}"
                        Margin="0,0,5,0"
                        Command="{Binding TerminateMeasurementCommand}"
                        Content="终止测量"
                        Style="{StaticResource ButtonDanger}" />
                    <Button
                        Width="{StaticResource FormLabelWidth}"
                        Margin="0,0,5,0"
                        Command="{Binding PreviousStepCommand}"
                        Content="上一工步"
                        Style="{StaticResource ButtonPrimary}"
                        Visibility="{Binding CurrentRecipe.OtherSettings.EnableStepMode, Converter={StaticResource Boolean2VisibilityConverter}}" />
                    <Button
                        Width="{StaticResource FormLabelWidth}"
                        Margin="0,0,5,0"
                        Command="{Binding NextStepCommand}"
                        Content="下一工步"
                        Style="{StaticResource ButtonSuccess}"
                        Visibility="{Binding CurrentRecipe.OtherSettings.EnableStepMode, Converter={StaticResource Boolean2VisibilityConverter}}" />
                    <Button
                        Width="{StaticResource FormLabelWidth}"
                        Margin="0,0,5,0"
                        Command="{Binding ClearDataCommand}"
                        Content="清空数据"
                        Style="{StaticResource ButtonWarning}" />

                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Visibility="{Binding CurrentRecipe.OtherSettings.EnableStepMode, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <Run Text="当前工步：" />
                        <Run
                            FontWeight="Bold"
                            Foreground="{StaticResource StatusInfoBrush}"
                            Text="{Binding CurrentStep}" />
                    </TextBlock>
                </StackPanel>
                <!--<Button Style="{StaticResource SaveRecipeButton}" Command="{Binding SaveRecipeCommand}"/>-->

                <hc:ContextMenuButton
                    Margin="0,0,5,0"
                    Padding="12,5"
                    HorizontalAlignment="Right"
                    Content="更多 ▾"
                    Style="{StaticResource ButtonInfo}"
                    ToolTip="布局与显示选项">
                    <hc:ContextMenuButton.Menu>
                        <ContextMenu>
                            <MenuItem
                                x:Name="LayoutMenuItem"
                                Click="ToggleLayout_Click"
                                Header="切换为水平布局" />
                            <MenuItem Click="RestoreDefaultLayout_Click" Header="恢复默认布局" />
                            <Separator />
                            <MenuItem
                                x:Name="showNg"
                                Click="ToggleGuidePanel_Click"
                                Header="隐藏导向区" />
                        </ContextMenu>
                    </hc:ContextMenuButton.Menu>
                </hc:ContextMenuButton>
            </Grid>
        </Border>

        <!--  主显示区域  -->
        <Grid x:Name="MainContentGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" MinWidth="180" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" MinHeight="120" />
            </Grid.RowDefinitions>

            <!--  左上：产品图片（仅展示）  -->
            <Border
                x:Name="ImagePanel"
                Grid.Row="0"
                Grid.Column="0"
                Margin="5"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
                <Grid ClipToBounds="True">
                    <!--  图片 + 标注同尺寸叠加  -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image
                            x:Name="HomeProductImage"
                            Source="{Binding ProductImagePath, Converter={StaticResource StringToImageSourceConverter}}"
                            Stretch="Uniform" />

                        <!--  标注点叠加层（相对坐标，按工步显示）  -->
                        <ItemsControl IsHitTestVisible="False" ItemsSource="{Binding Annotations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource RelativeToPixelConverter}">
                                                <Binding Path="X" />
                                                <Binding ElementName="HomeProductImage" Path="ActualWidth" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Canvas.Top">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource RelativeToPixelConverter}">
                                                <Binding Path="Y" />
                                                <Binding ElementName="HomeProductImage" Path="ActualHeight" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:AnnotationMarkerControl Recipe="{Binding DataContext.CurrentRecipe, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!--  遮罩层：无图片时显示  -->
                    <Border Background="{StaticResource LightBackgroundBrush}" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProductImagePath}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ProductImagePath}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,10"
                                HorizontalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="64"
                                Foreground="{StaticResource DisabledIconBrush}"
                                Text="&#xE8B9;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="16"
                                Foreground="{StaticResource DisabledTextBrush}"
                                Text="请在通道配置中导入产品图片" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!--  左右拖动分割条  -->
            <GridSplitter
                x:Name="HorizontalSplitter"
                Grid.Row="0"
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="Transparent"
                Cursor="SizeWE"
                DragCompleted="Splitter_DragCompleted"
                ShowsPreview="True" />
            <!--  右上：测量向导区  -->
            <Border
                x:Name="GuidePanel"
                Grid.Row="0"
                Grid.Column="2"
                Margin="5"
                Background="{StaticResource LightBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock
                            Margin="0,0,0,15"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="Bold"
                            Text="测量向导区" />

                        <!--  OK/NG 状态指示  -->
                        <Border
                            Margin="0,5"
                            Padding="10"
                            CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource DisabledIconBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverallResult}" Value="Pass">
                                            <Setter Property="Background" Value="{StaticResource StatusSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OverallResult}" Value="Fail">
                                            <Setter Property="Background" Value="{StaticResource StatusErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="White">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="--" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OverallResult}" Value="Pass">
                                                <Setter Property="Text" Value="OK" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OverallResult}" Value="Fail">
                                                <Setter Property="Text" Value="NG" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!--  二维码位置  -->

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,3"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource PlaceholderTextBrush}"
                                Text="二维码：" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                FontSize="15"
                                Text="{Binding CurrentBarcode}"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource StatusInfoBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentBarcodeValidationPassed}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentBarcodeValidationPassed}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="12"
                                Text="{Binding CurrentBarcodeValidationMessage}"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource PlaceholderTextBrush}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentBarcodeValidationMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentBarcodeValidationMessage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentBarcodeValidationPassed}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentBarcodeValidationPassed}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Separator Margin="0,5" />

                        <!--  当前状态  -->

                        <TextBlock
                            Margin="0,0,0,3"
                            FontSize="12"
                            Foreground="{StaticResource PlaceholderTextBrush}"
                            Text="当前状态：" />
                        <TextBlock
                            FontSize="15"
                            Foreground="{StaticResource StatusInfoBrush}"
                            Text="{Binding MeasurementStatus}" />

                        <Separator Margin="0,5" />

                        <!--  统计  -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource PlaceholderTextBrush}"
                                    Text="总数" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Text="{Binding TotalCount}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource StatusSuccessBrush}"
                                    Text="合格" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource StatusSuccessBrush}"
                                    Text="{Binding PassCount}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource StatusErrorBrush}"
                                    Text="不合格" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource StatusErrorBrush}"
                                    Text="{Binding FailCount}" />
                            </StackPanel>

                        </Grid>
                        <Separator Margin="0,0,0,5" />
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Left">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    FontSize="11"
                                    Foreground="{StaticResource StatusSuccessBrush}"
                                    Text="合格率" />
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource StatusSuccessBrush}"
                                    Text="{Binding PassRate}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Right">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="11"
                                    Foreground="{StaticResource StatusErrorBrush}"
                                    Text="不合格率" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource StatusErrorBrush}"
                                    Text="{Binding FailRate}" />
                            </StackPanel>

                        </Grid>

                        <Separator Margin="0,0,0,5" />


                        <!--  测量步骤  -->
                        <TextBlock
                            Margin="0,5,0,3"
                            FontSize="12"
                            Foreground="{StaticResource PlaceholderTextBrush}"
                            Text="1. 放置产品" />
                        <TextBlock
                            Margin="0,3"
                            FontSize="12"
                            Foreground="{StaticResource PlaceholderTextBrush}"
                            Text="2. 点击开始测量" />
                        <TextBlock
                            Margin="0,3"
                            FontSize="12"
                            Foreground="{StaticResource PlaceholderTextBrush}"
                            Text="3. 等待测量完成" />
                        <TextBlock
                            Margin="0,3"
                            FontSize="12"
                            Foreground="{StaticResource PlaceholderTextBrush}"
                            Text="4. 查看测量结果" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  上下拖动分割条  -->
            <GridSplitter
                x:Name="VerticalSplitter"
                Grid.Row="1"
                Grid.ColumnSpan="3"
                Height="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="Transparent"
                Cursor="SizeNS"
                DragCompleted="Splitter_DragCompleted"
                ShowsPreview="True" />

            <!--  底部：通道数据表格（横跨所有列）  -->
            <Border
                x:Name="TablePanel"
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="5"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  表格标题  -->
                    <Border
                        Grid.Row="0"
                        Padding="10"
                        Background="White"
                        BorderBrush="{StaticResource LightBorderBrush}"
                        BorderThickness="0,1,0,1">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Bold"
                            Text="通道测量数据" />
                    </Border>

                    <!--  数据表格  -->
                    <DataGrid
                        Grid.Row="1"
                        AlternationCount="2"
                        AutoGenerateColumns="False"
                        Background="{DynamicResource BackgroundColor}"
                        BorderThickness="0"
                        ColumnHeaderStyle="{StaticResource ColoredHeaderStyle}"
                        FontSize="12"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Channels}"
                        RowHeight="35"
                        RowStyle="{StaticResource MeasurementDataGridRowStyle}"
                        SelectionMode="Single">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    Command="{Binding ExportChannelDataCsvCommand}"
                                    CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    Header="导出当前通道数据" />
                                <MenuItem Command="{Binding ExportAllChannelDataCsvCommand}" Header="导出全部通道数据" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="70" Header="通道">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding Converter="{StaticResource ChannelDisplayTextConverter}">
                                        <Binding ElementName="HomeControl" Path="DataContext.CurrentRecipe.OtherSettings.ChannelDisplayPrefix" />
                                        <Binding Path="ChannelNumber" />
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding ChannelName}"
                                Header="名称" />
                            <DataGridTextColumn
                                Width="50"
                                Binding="{Binding StepNumber}"
                                Header="工步" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding MeasurementType}"
                                Header="测量类型" />
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding ChannelDescription}"
                                Header="说明" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding StandardValue}"
                                Header="标准值" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding UpperTolerance}"
                                Header="上公差" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding LowerTolerance}"
                                Header="下公差" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding DisplayMeasuredValue}"
                                Header="实时值" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding DisplayResultValue}"
                                Header="结果值" />
                            <DataGridTemplateColumn Width="70" Header="结果">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="5,2" CornerRadius="3">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource ChannelResultBrushConverter}">
                                                    <Binding ElementName="HomeControl" Path="DataContext.CurrentRecipe.OtherSettings.OkColor" />
                                                    <Binding ElementName="HomeControl" Path="DataContext.CurrentRecipe.OtherSettings.NgColor" />
                                                    <Binding ElementName="HomeControl" Path="DataContext.CurrentRecipe.OtherSettings.AcquiringColor" />
                                                    <Binding Path="DisplayState" />
                                                </MultiBinding>
                                            </Border.Background>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontWeight="Bold"
                                                Text="{Binding DisplayResultText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DisplayState}" Value="Waiting">
                                                                <Setter Property="Foreground" Value="#FF666666" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DisplayState}" Value="Acquiring">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
