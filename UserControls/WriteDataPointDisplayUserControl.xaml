<UserControl
    x:Class="MeasurementSoftware.UserControls.WriteDataPointDisplayUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helpers="clr-namespace:MeasurementSoftware.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="DisplayRoot"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <helpers:BindingProxy x:Key="VmProxy" Data="{Binding}" />
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding CommitDisplayValueEditCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelDisplayValueEditCommand}" />
    </UserControl.InputBindings>
    <Grid Style="{StaticResource PageRootGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageToolbarBorder}">
            <Grid>

                <Button Command="{Binding SaveRecipeCommand}" Style="{StaticResource SaveRecipeButton}" />
            </Grid>
        </Border>


        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>



            <DataGrid
                Grid.Row="1"
                Margin="12"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                ItemsSource="{Binding EnabledWriteDataPoints}"
                SelectedItem="{Binding SelectedWriteDataPoint, Mode=TwoWay}"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="60"
                        Binding="{Binding Index, Mode=OneWay}"
                        Header="ID"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding DisplayName, Mode=OneWay}"
                        Header="名称"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="130"
                        Binding="{Binding SelectedDeviceName, Mode=OneWay}"
                        Header="设备"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding SelectedPointName, Mode=OneWay}"
                        Header="点位"
                        IsReadOnly="True" />
                    <DataGridTemplateColumn Width="240" Header="值/操作">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsValueEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <ContentControl Visibility="{Binding IsLabelMode, Converter={StaticResource Boolean2VisibilityConverter}}">
                                            <TextBlock VerticalAlignment="Center" Text="{Binding CurrentValueDisplayText}" />
                                        </ContentControl>
                                        <ContentControl Visibility="{Binding IsTextBoxMode, Converter={StaticResource Boolean2VisibilityConverter}}">
                                            <Border
                                                Background="Transparent"
                                                Cursor="Hand"
                                                PreviewMouseLeftButtonDown="TextBoxValueBorder_PreviewMouseLeftButtonDown">
                                                <TextBlock VerticalAlignment="Center" Text="{Binding PendingWriteValueText}" />
                                            </Border>
                                        </ContentControl>
                                        <ContentControl Visibility="{Binding IsButtonMode, Converter={StaticResource Boolean2VisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <!--<TextBlock VerticalAlignment="Center" Text="{Binding PendingWriteValueText}" />-->

                                                <Button
                                                    MaxWidth="100"
                                                    Margin="0,0,0,0"
                                                    Padding="10,4"
                                                    HorizontalContentAlignment="Left"
                                                    Command="{Binding Data.SubmitButtonWriteCommand, Source={StaticResource VmProxy}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding ButtonDisplayText}"
                                                    Style="{StaticResource ButtonDefault}">

                                                    <Button.ToolTip>
                                                        <TextBlock Text="{Binding ButtonDisplayText}" />
                                                    </Button.ToolTip>
                                                    <Button.ContentTemplate>
                                                        <DataTemplate>
                                                            <TextBlock
                                                                Text="{Binding}"
                                                                TextTrimming="CharacterEllipsis"
                                                                ToolTip="{Binding}" />
                                                        </DataTemplate>
                                                    </Button.ContentTemplate>
                                                </Button>
                                            </StackPanel>
                                        </ContentControl>
                                    </Grid>
                                    <StackPanel Grid.Row="1">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsValueEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsButtonMode}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBox
                                                Width="110"
                                                Margin="0,0,6,0"
                                                hc:InfoElement.Necessary="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.HasError)}"
                                                Style="{StaticResource TextBoxExtend}"
                                                Text="{Binding EditingWriteValueText, UpdateSourceTrigger=PropertyChanged, Delay=100, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                                ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors).CurrentItem.ErrorContent}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding
                                                        Key="Enter"
                                                        Command="{Binding Data.CommitRowValueEditCommand, Source={StaticResource VmProxy}}"
                                                        CommandParameter="{Binding}" />
                                                    <KeyBinding
                                                        Key="Escape"
                                                        Command="{Binding Data.CancelRowValueEditCommand, Source={StaticResource VmProxy}}"
                                                        CommandParameter="{Binding}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <Button
                                                Margin="0,0,6,0"
                                                Padding="10,4"
                                                Command="{Binding Data.CommitRowValueEditCommand, Source={StaticResource VmProxy}}"
                                                CommandParameter="{Binding}"
                                                Content="写入"
                                                Style="{StaticResource ButtonDanger}" />
                                            <Button
                                                Padding="10,4"
                                                Command="{Binding Data.CancelRowValueEditCommand, Source={StaticResource VmProxy}}"
                                                CommandParameter="{Binding}"
                                                Content="取消"
                                                Style="{StaticResource ButtonDefault}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="110"
                        Binding="{Binding EditorMode, Converter={StaticResource EnumDescriptionConverter}, Mode=OneWay}"
                        Header="写值方式"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Unit, Mode=OneWay}"
                        Header="单位"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="200"
                        MinWidth="200"
                        Binding="{Binding DisplayDescription, Mode=OneWay}"
                        Header="说明"
                        IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

    </Grid>
</UserControl>