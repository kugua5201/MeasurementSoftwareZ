<UserControl
    x:Class="MeasurementSoftware.UserControls.FormulaFunctionHelpUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="620"
    d:DesignWidth="860"
    mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0,0,0,12"
            FontSize="18"
            FontWeight="Bold"
            Text="间接/虚拟测量公式函数说明" />

        <Border
            Grid.Row="1"
            Background="White"
            BorderBrush="#D8D8D8"
            BorderThickness="1"
            CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox
                    x:Name="HelpContentTextBox"
                    Padding="12"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Consolas"
                    FontSize="13"
                    IsReadOnly="True"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Disabled" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
