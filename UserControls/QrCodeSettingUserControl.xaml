<UserControl
    x:Class="MeasurementSoftware.UserControls.QrCodeSettingUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:MeasurementSoftware.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  页面级资源仅保留全局未覆盖的项  -->
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRootGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶部操作栏  -->
        <Border Grid.Row="0" Style="{StaticResource PageToolbarBorder}">
            <Grid>
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" />
                <Button Command="{Binding SaveConfigurationCommand}" Style="{StaticResource SaveRecipeButton}" />
            </Grid>
        </Border>

        <hc:ScrollViewer Grid.Row="1">
            <StackPanel Margin="10" Orientation="Vertical">
                <!--  基本设置  -->
                <hc:Card
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Effect="{StaticResource EffectShadow2}">
                    <hc:Card.Header>
                        <StackPanel Margin="10,5" Orientation="Horizontal">
                            <Path
                                Width="18"
                                Height="18"
                                Margin="0,0,8,0"
                                Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                Fill="{DynamicResource PrimaryBrush}"
                                Stretch="Uniform" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Style="{StaticResource TextBlockDefault}"
                                Text="基本设置" />
                        </StackPanel>
                    </hc:Card.Header>
                    <StackPanel Margin="15" Orientation="Vertical">

                        <!--  启用二维码  -->
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                Width="{StaticResource FormLabelWidth}"
                                VerticalAlignment="Center"
                                Text="启用二维码：" />
                            <ToggleButton IsChecked="{Binding Config.IsEnabled, Mode=TwoWay}" Style="{StaticResource ToggleButtonSwitch}" />
                        </StackPanel>

                        <StackPanel
                            Margin="0,0,0,8"
                            Orientation="Horizontal"
                            Visibility="{Binding Config.IsEnabled, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <TextBlock
                                Width="{StaticResource FormLabelWidth}"
                                VerticalAlignment="Center"
                                Text="测量启动前扫码：" />
                            <ToggleButton IsChecked="{Binding Config.RequireQrCodeBeforeMeasurement, Mode=TwoWay}" Style="{StaticResource ToggleButtonSwitch}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="启用后启动测量先清空数据并等待扫码，收到有效二维码后才开始通道采集；打开后会自动关闭下方完成判NG" />
                        </StackPanel>

                        <StackPanel
                            Margin="0,0,0,8"
                            Orientation="Horizontal"
                            Visibility="{Binding Config.IsEnabled, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <TextBlock
                                Width="{StaticResource FormLabelWidth}"
                                VerticalAlignment="Center"
                                Text="结束扫码判断：" />
                            <ToggleButton IsChecked="{Binding Config.EnableMeasurementCompletedScanTimeoutRule, Mode=TwoWay}" Style="{StaticResource ToggleButtonSwitch}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="启用后测量结束时不再继续等待扫码，超出延时仍未扫码则强制判定 NG；打开后会自动关闭上方必须扫码" />
                        </StackPanel>

                        <StackPanel
                            Margin="0,0,0,8"
                            Orientation="Horizontal"
                            Visibility="{Binding Config.EnableMeasurementCompletedScanTimeoutRule, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <TextBlock
                                Width="{StaticResource FormLabelWidth}"
                                VerticalAlignment="Center"
                                Text="结束延时：" />
                            <hc:NumericUpDown
                                Width="{StaticResource FormInputWidth}"
                                HorizontalAlignment="Left"
                                Increment="1000"
                                Maximum="600000"
                                Minimum="0"
                                Value="{Binding Config.MeasurementCompletedScanTimeoutMs, Mode=TwoWay}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="ms，测量完成后在此时间内仍可接收扫码；超时未扫码则强制 NG" />
                        </StackPanel>

                        <!--  数据源类型  -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Config.IsEnabled, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <TextBlock
                                Width="{StaticResource FormLabelWidth}"
                                VerticalAlignment="Center"
                                Text="数据源类型：" />
                            <ComboBox
                                Width="{StaticResource FormInputWidth}"
                                hc:InfoElement.Placeholder="请选择二维码数据来源"
                                ItemsSource="{Binding SourceTypes}"
                                SelectedItem="{Binding Config.SourceType}"
                                Style="{StaticResource ComboBoxExtend}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                    </StackPanel>
                </hc:Card>

                <!--  数据源配置  -->
                <hc:Card
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Effect="{StaticResource EffectShadow2}"
                    Visibility="{Binding Config.IsEnabled, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <hc:Card.Header>
                        <StackPanel Margin="10,5" Orientation="Horizontal">
                            <Path
                                Width="18"
                                Height="18"
                                Margin="0,0,8,0"
                                Data="M17,7H22V17H17V19A1,1 0 0,0 18,20H20V22H17.5C16.95,22 16,21.55 16,21C16,21.55 15.05,22 14.5,22H12V20H14A1,1 0 0,0 15,19V5A1,1 0 0,0 14,4H12V2H14.5C15.05,2 16,2.45 16,3C16,2.45 16.95,2 17.5,2H20V4H18A1,1 0 0,0 17,5V7M2,7H13V9H4V15H13V17H2V7M20,15V9H17V15H20Z"
                                Fill="{DynamicResource SuccessBrush}"
                                Stretch="Uniform" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Style="{StaticResource TextBlockDefault}"
                                Text="数据源配置" />
                        </StackPanel>
                    </hc:Card.Header>
                    <StackPanel Margin="10" Orientation="Vertical">

                        <!--  键盘输入配置  -->
                        <Border
                            Padding="10"
                            Background="{DynamicResource InfoBrush}"
                            CornerRadius="4"
                            Visibility="{Binding IsKeyboardInputVisible, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,10,0"
                                    Data="M11,4H13V16L18.5,10.5L19.92,11.92L12,19.84L4.08,11.92L5.5,10.5L11,16V4Z"
                                    Fill="White"
                                    Stretch="Uniform" />
                                <StackPanel>
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="键盘输入模式已启用" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="White"
                                        Opacity="0.9"
                                        Text="支持USB扫码枪或键盘直接输入，焦点位于输入框时自动接收,键盘输入内容输入完毕时，需按下回车键" />
                                </StackPanel>

                            </StackPanel>
                        </Border>

                        <!--  串口通信配置  -->
                        <StackPanel Margin="5,10,5,0" Visibility="{Binding IsSerialPortVisible, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  COM口 + 刷新  -->
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,0,8"
                                    VerticalAlignment="Center"
                                    Text="COM 口：" />
                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Orientation="Horizontal">
                                    <ComboBox
                                        Width="{StaticResource PlcFieldInputWidth}"
                                        VerticalAlignment="Center"
                                        hc:InfoElement.Placeholder="请选择串口"
                                        IsEditable="False"
                                        ItemsSource="{Binding AvailableComPorts}"
                                        SelectedItem="{Binding Config.SerialPortName, Mode=TwoWay}"
                                        Style="{StaticResource ComboBoxExtend}" />
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Margin="8,0,0,0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Command="{Binding RefreshComPortsCommand}"
                                        Cursor="Hand"
                                        Style="{StaticResource ButtonDefault}"
                                        ToolTip="刷新串口列表">
                                        <Path
                                            Width="14"
                                            Height="14"
                                            Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                            Fill="{DynamicResource PrimaryTextBrush}"
                                            Stretch="Uniform" />
                                    </Button>
                                </StackPanel>

                                <!--  波特率  -->
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,0,8"
                                    VerticalAlignment="Center"
                                    Text="波特率：" />
                                <ComboBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Width="{StaticResource PlcFieldInputWidth}"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    ItemsSource="{Binding Source={StaticResource BaudRateValues}}"
                                    SelectedItem="{Binding Config.BaudRate, Mode=TwoWay}"
                                    Style="{StaticResource ComboBoxExtend}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!--  数据位  -->
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,0,0,8"
                                    VerticalAlignment="Center"
                                    Text="数据位：" />
                                <ComboBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Width="{StaticResource PlcFieldInputWidth}"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    ItemsSource="{Binding Source={StaticResource DataBitsValues}}"
                                    SelectedItem="{Binding Config.DataBits, Mode=TwoWay}"
                                    Style="{StaticResource ComboBoxExtend}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!--  停止位  -->
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,0,0,8"
                                    VerticalAlignment="Center"
                                    Text="停止位：" />
                                <ComboBox
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Width="{StaticResource PlcFieldInputWidth}"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    ItemsSource="{Binding Source={StaticResource StopBitsValues}}"
                                    SelectedItem="{Binding Config.StopBits, Mode=TwoWay}"
                                    Style="{StaticResource ComboBoxExtend}" />

                                <!--  校验位  -->
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="校验位：" />
                                <ComboBox
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Width="{StaticResource PlcFieldInputWidth}"
                                    HorizontalAlignment="Left"
                                    ItemsSource="{Binding Source={StaticResource ParityValues}}"
                                    SelectedItem="{Binding Config.Parity, Mode=TwoWay}"
                                    Style="{StaticResource ComboBoxExtend}" />
                            </Grid>
                        </StackPanel>
                        <!--  以太网通信配置  -->
                        <StackPanel Margin="5,10,5,0" Visibility="{Binding IsEthernetVisible, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,0,8"
                                    VerticalAlignment="Center"
                                    Text="IP地址：" />
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="{StaticResource PlcFieldInputWidth}"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    hc:InfoElement.Placeholder="例如：192.168.1.100"
                                    Style="{StaticResource TextBoxExtend}"
                                    Text="{Binding Config.EthernetIp, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,0,8"
                                    VerticalAlignment="Center"
                                    Text="端口号：" />
                                <hc:NumericUpDown
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Width="{StaticResource PlcFieldInputWidth}"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    Maximum="65535"
                                    Minimum="1"
                                    Value="{Binding Config.EthernetPort}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="通信协议：" />
                                <ComboBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Width="{StaticResource PlcFieldInputWidth}"
                                    HorizontalAlignment="Left"
                                    hc:InfoElement.Placeholder="选择协议类型"
                                    ItemsSource="{Binding ProtocolList}"
                                    SelectedItem="{Binding Config.EthernetProtocol}"
                                    Style="{StaticResource ComboBoxExtend}" />
                            </Grid>
                        </StackPanel>

                        <!--  PLC寄存器配置  -->
                        <StackPanel Margin="5,10,5,0" Visibility="{Binding IsPlcRegisterVisible, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,0,8"
                                    VerticalAlignment="Center"
                                    Text="PLC设备：" />
                                <ComboBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="{StaticResource FormInputWidth}"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    hc:InfoElement.Placeholder="选择已配置的PLC设备"
                                    DisplayMemberPath="DeviceName"
                                    ItemsSource="{Binding PlcDevices}"
                                    SelectedItem="{Binding Config.SelectedPlcDevice}"
                                    Style="{StaticResource ComboBoxExtend}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,0,8"
                                    VerticalAlignment="Center"
                                    Text="点位地址：" />
                                <ComboBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Width="{StaticResource FormInputWidth}"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    hc:InfoElement.Placeholder="选择点位地址"
                                    DisplayMemberPath="PointName"
                                    ItemsSource="{Binding AvailablePoints}"
                                    SelectedItem="{Binding Config.SelectedPoint}"
                                    Style="{StaticResource ComboBoxExtend}" />

                                <!--<TextBlock Grid.Row="2" Grid.Column="0" Text="读取长度：" VerticalAlignment="Center"/>
                            <hc:NumericUpDown Grid.Row="2" Grid.Column="1"
                                              Value="{Binding Config.PlcReadLength}"
                                              Minimum="1" Maximum="1000"
                                              Width="{StaticResource FormInputWidth}" HorizontalAlignment="Left"/>-->
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </hc:Card>

                <!--  数据校验配置  -->
                <hc:Card
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Effect="{StaticResource EffectShadow2}"
                    Visibility="{Binding Config.IsEnabled, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <hc:Card.Header>
                        <StackPanel Margin="10,5" Orientation="Horizontal">
                            <Path
                                Width="18"
                                Height="18"
                                Margin="0,0,8,0"
                                Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                Fill="{DynamicResource WarningBrush}"
                                Stretch="Uniform" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Style="{StaticResource TextBlockDefault}"
                                Text="数据校验与提取配置" />
                        </StackPanel>
                    </hc:Card.Header>
                    <StackPanel Margin="15" Orientation="Vertical">

                        <!--  校验规则  -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  起始符  -->
                            <CheckBox
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,0,8"
                                VerticalAlignment="Center"
                                Content="启用起始符校验"
                                IsChecked="{Binding Config.EnableStartSymbol}" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Width="{StaticResource FormInputWidth}"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Left"
                                hc:InfoElement.Placeholder="例如：\r"
                                IsEnabled="{Binding Config.EnableStartSymbol}"
                                Style="{StaticResource TextBoxExtend}"
                                Text="{Binding Config.StartSymbol, UpdateSourceTrigger=PropertyChanged}" />

                            <!--  结束符  -->
                            <CheckBox
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,0,8"
                                VerticalAlignment="Center"
                                Content="启用结束符校验"
                                IsChecked="{Binding Config.EnableEndSymbol}" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="{StaticResource FormInputWidth}"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Left"
                                hc:InfoElement.Placeholder="例如：\n"
                                IsEnabled="{Binding Config.EnableEndSymbol}"
                                Style="{StaticResource TextBoxExtend}"
                                Text="{Binding Config.EndSymbol, UpdateSourceTrigger=PropertyChanged}" />

                            <!--  长度校验  -->
                            <CheckBox
                                Grid.Row="2"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Content="启用长度校验"
                                IsChecked="{Binding Config.EnableLengthCheck}" />
                            <hc:NumericUpDown
                                Grid.Row="2"
                                Grid.Column="1"
                                Width="{StaticResource FormInputWidth}"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding Config.EnableLengthCheck}"
                                Maximum="1000"
                                Minimum="1"
                                Value="{Binding Config.ExpectedLength}" />
                        </Grid>

                        <Separator Margin="0,5" />

                        <!--  数据提取  -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,0,8"
                                VerticalAlignment="Center"
                                Text="起始位置索引：" />
                            <hc:NumericUpDown
                                Grid.Row="0"
                                Grid.Column="1"
                                Width="{StaticResource FormInputWidth}"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Left"
                                Maximum="999"
                                Minimum="0"
                                Value="{Binding Config.QrCodeStartIndex}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="提取字符长度：" />
                            <hc:NumericUpDown
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="{StaticResource FormInputWidth}"
                                HorizontalAlignment="Left"
                                Maximum="1000"
                                Minimum="1"
                                Value="{Binding Config.QrCodeLength}" />
                        </Grid>

                    </StackPanel>
                </hc:Card>

                <!--  批次流水号配置  -->
                <hc:Card
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Effect="{StaticResource EffectShadow2}"
                    Visibility="{Binding IsBatchModeVisible, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <hc:Card.Header>
                        <StackPanel Margin="10,5" Orientation="Horizontal">
                            <Path
                                Width="18"
                                Height="18"
                                Margin="0,0,8,0"
                                Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V5H19V19H5V5H7V7M17,11H7V9H17V11M15,15H7V13H15V15Z"
                                Fill="{DynamicResource DangerBrush}"
                                Stretch="Uniform" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Style="{StaticResource TextBlockDefault}"
                                Text="批次流水号配置" />
                        </StackPanel>
                    </hc:Card.Header>
                    <StackPanel Margin="15" Orientation="Vertical">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  流水号前缀  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,0,8"
                                VerticalAlignment="Center"
                                Text="流水号前缀：" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Width="{StaticResource FormInputWidth}"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Left"
                                hc:InfoElement.Placeholder="例如：BATCH"
                                Style="{StaticResource TextBoxExtend}"
                                Text="{Binding Config.BatchPrefix, UpdateSourceTrigger=PropertyChanged}" />

                            <!--  日期格式  -->
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,0,8"
                                VerticalAlignment="Center"
                                Text="日期格式：" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="{StaticResource FormInputWidth}"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Left"
                                hc:InfoElement.Placeholder="例如：yyyyMMdd"
                                Style="{StaticResource TextBoxExtend}"
                                Text="{Binding Config.BatchDateFormat, UpdateSourceTrigger=PropertyChanged}" />

                            <!--  流水号位数  -->
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,0,0,8"
                                VerticalAlignment="Center"
                                Text="流水号位数：" />
                            <hc:NumericUpDown
                                Grid.Row="2"
                                Grid.Column="1"
                                Width="{StaticResource FormInputWidth}"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Left"
                                Maximum="10"
                                Minimum="1"
                                Value="{Binding Config.BatchSerialDigits}" />

                            <!--  当前流水号  -->
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,0,0,8"
                                VerticalAlignment="Center"
                                Text="当前流水号：" />
                            <Border
                                Grid.Row="3"
                                Grid.Column="1"
                                Width="{StaticResource FormInputWidth}"
                                Margin="0,0,0,8"
                                Padding="8,4"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource SecondaryRegionBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Text="{Binding Config.CurrentBatchSerial}" />
                            </Border>

                            <!--  生成示例  -->
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="生成测试：" />
                            <Button
                                Grid.Row="4"
                                Grid.Column="1"
                                Width="{StaticResource FormButtonWidth}"
                                HorizontalAlignment="Left"
                                Command="{Binding GenerateBatchNumberCommand}"
                                Content="生成示例"
                                Style="{StaticResource ButtonWarning}" />
                        </Grid>

                    </StackPanel>
                </hc:Card>

                <!--  测试区域  -->
                <hc:Card
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Effect="{StaticResource EffectShadow2}">
                    <hc:Card.Header>
                        <StackPanel Margin="10,5" Orientation="Horizontal">
                            <Path
                                Width="18"
                                Height="18"
                                Margin="0,0,8,0"
                                Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,5V19H5V5H19M16.5,16.25L9,12.75V7.75L16.5,11.25V16.25Z"
                                Fill="{DynamicResource PrimaryBrush}"
                                Stretch="Uniform" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Style="{StaticResource TextBlockDefault}"
                                Text="测试与验证" />
                        </StackPanel>
                    </hc:Card.Header>
                    <StackPanel Margin="15" Orientation="Vertical">

                        <Border
                            Margin="0,0,0,10"
                            Padding="10"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock
                                Foreground="{DynamicResource StatusInfoBrush}"
                                Text="{Binding ListenValidationStatus}"
                                TextWrapping="Wrap" />
                        </Border>

                        <!--  测试数据输入  -->
                        <TextBox
                            x:Name="TestRawDataInputBox"
                            Height="60"
                            hc:InfoElement.Placeholder="在此输入测试数据；"
                            AcceptsReturn="True"
                            IsEnabled="{Binding Config.IsEnabled}"
                            PreviewKeyDown="TestRawDataInputBox_PreviewKeyDown"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Config.TestRawData, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />

                        <!--  操作与结果显示  -->
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Button
                                Margin="0,0,8,0"
                                Padding="15,6"
                                Command="{Binding StartListenValidationCommand}"
                                Content="监听验证"
                                IsEnabled="{Binding CanStartListenValidation}"
                                Style="{StaticResource ButtonPrimary}" />
                            <Button
                                Margin="0,0,8,0"
                                Padding="15,6"
                                Command="{Binding StopListenValidationCommand}"
                                Content="停止监听"
                                IsEnabled="{Binding CanStopListenValidation}"
                                Style="{StaticResource ButtonDanger}" />
                            <Button
                                Margin="0,0,8,0"
                                Padding="15,6"
                                Command="{Binding TestExtractionCommand}"
                                Content="测试提取"
                                IsEnabled="{Binding Config.IsEnabled}"
                                Style="{StaticResource ButtonSuccess}" />
                            <Button
                                Padding="15,6"
                                Command="{Binding ClearTestDataCommand}"
                                Content="清除"
                                IsEnabled="{Binding Config.IsEnabled}"
                                Style="{StaticResource ButtonDefault}"
                                ToolTip="清除测试数据" />

                            <!--  结果展示  -->
                            <Border
                                Margin="15,0,0,0"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="结果：" />
                                    <TextBlock
                                        Margin="5,0,15,0"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource SuccessBrush}"
                                        Text="{Binding Config.TestExtractedQrCode}"
                                        Visibility="{Binding Config.TestExtractedQrCode, Converter={StaticResource String2VisibilityConverter}}" />
                                    <TextBlock
                                        MaxWidth="400"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{Binding Config.TestValidationResult}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Config.TestValidationResult}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Config.TestValidationPassed}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Config.TestValidationPassed}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </hc:Card>

            </StackPanel>
        </hc:ScrollViewer>
    </Grid>
</UserControl>
