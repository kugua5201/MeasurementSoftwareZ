                                                                        CommandParameter="{Binding}"
                                                                        Header="检查脚本" />


                                                                </ContextMenu>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn
                                                        Width="100"
                                                        Binding="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}"
                                                        Header="变量名" />

                                                    <DataGridTemplateColumn Width="100" Header="设备">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding SelectedDeviceName}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                        <DataGridTemplateColumn.CellEditingTemplate>
                                                            <DataTemplate>
                                                                <hc:ComboBox
                                                                    DisplayMemberPath="DeviceName"
                                                                    ItemContainerStyle="{StaticResource WriteDataPointComboBoxItemStyle}"
                                                                    ItemsSource="{Binding AvailableDevicesSource}"
                                                                    SelectedItem="{Binding RuntimeDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    Style="{StaticResource ComboBoxExtend}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellEditingTemplate>
                                                    </DataGridTemplateColumn>

                                                    <DataGridTemplateColumn Width="150" Header="点位">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding SelectedPointName}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                        <DataGridTemplateColumn.CellEditingTemplate>
                                                            <DataTemplate>
                                                                <hc:ComboBox
                                                                    DisplayMemberPath="PointName"
                                                                    ItemContainerStyle="{StaticResource WriteDataPointComboBoxItemStyle}"
                                                                    ItemsSource="{Binding AvailableDataPoints}"
                                                                    SelectedItem="{Binding RuntimeDataPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    Style="{StaticResource ComboBoxExtend}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellEditingTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </hc:Drawer>
        </Grid>
    </hc:SimplePanel>
</UserControl>