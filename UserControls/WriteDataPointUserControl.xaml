<UserControl
    x:Class="MeasurementSoftware.UserControls.WriteDataPointUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
    xmlns:behaviors="clr-namespace:MeasurementSoftware.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:diag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helpers="clr-namespace:MeasurementSoftware.Helpers"
    xmlns:highlighting="clr-namespace:MeasurementSoftware.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <helpers:BindingProxy x:Key="VmProxy" Data="{Binding}" />
        <Style
            x:Key="WriteDataPointComboBoxItemStyle"
            BasedOn="{StaticResource ComboBoxItemBaseStyle}"
            TargetType="ComboBoxItem">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <hc:SimplePanel>
        <Grid Style="{StaticResource PageRootGrid}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PageToolbarBorder}">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Padding="15,6"
                            Command="{Binding AddWriteDataPointCommand}"
                            Content="添加通道"
                            Style="{StaticResource ButtonPrimary}" />
                        <Button
                            Margin="0,0,8,0"
                            Padding="15,6"
                            Command="{Binding DeleteWriteDataPointCommand}"
                            Content="删除通道"
                            Style="{StaticResource ButtonDanger}" />
                        <Button
                            Margin="0,0,8,0"
                            Padding="15,6"
                            Command="{Binding UpChannelCommand}"
                            Content="上移通道"
                            Style="{StaticResource ButtonInfo}" />
                        <Button
                            Command="{Binding DownChannelCommand}"
                            Content="下移通道"
                            Style="{StaticResource ButtonSuccess}" />
                    </StackPanel>
                    <Button Command="{Binding SaveRecipeCommand}" Style="{StaticResource SaveRecipeButton}" />
                </Grid>
            </Border>


            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>



                <Grid Grid.Row="1">
                    <hc:TabControl
                        Margin="12"
                        IsDraggable="True"
                        IsScrollable="True"
                        ItemsSource="{Binding WriteDataPointPages}"
                        PreviewMouseRightButtonDown="TabControl_PreviewMouseRightButtonDown"
                        SelectedItem="{Binding SelectedEditPage, Mode=TwoWay}"
                        ShowCloseButton="False"
                        ShowContextMenu="False">
                        <hc:TabControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <ContextMenu.DataContext>
                                                <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource Self}" />
                                            </ContextMenu.DataContext>
                                            <MenuItem Command="{Binding Data.AddWriteDataPointPageCommand, Source={StaticResource VmProxy}}" Header="添加页面" />
                                            <MenuItem
                                                Command="{Binding Data.BeginEditWriteDataPointPageCommand, Source={StaticResource VmProxy}}"
                                                CommandParameter="{Binding}"
                                                Header="修改名称" />
                                            <MenuItem
                                                Command="{Binding Data.DeleteWriteDataPointPageCommand, Source={StaticResource VmProxy}}"
                                                CommandParameter="{Binding}"
                                                Header="删除页面">
                                                <MenuItem.Style>
                                                    <Style BasedOn="{StaticResource MenuItemBaseStyle}" TargetType="MenuItem">
                                                        <Setter Property="IsEnabled" Value="True" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PageIndex}" Value="1">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="删除页面并移动通道">
                                                <MenuItem.Style>
                                                    <Style BasedOn="{StaticResource MenuItemBaseStyle}" TargetType="MenuItem">
                                                        <Setter Property="IsEnabled" Value="True" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PageIndex}" Value="1">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                                <MenuItem.ItemsSource>
                                                    <Binding Path="Data.OtherEditPages" Source="{StaticResource VmProxy}" />
                                                </MenuItem.ItemsSource>
                                                <MenuItem.ItemContainerStyle>
                                                    <Style BasedOn="{StaticResource MenuItemBaseStyle}" TargetType="MenuItem">
                                                        <Setter Property="Header" Value="{Binding PageName}" />
                                                        <Setter Property="Command" Value="{Binding Data.DeleteWriteDataPointPageAndMoveChannelsCommand, Source={StaticResource VmProxy}}" />
                                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                                    </Style>
                                                </MenuItem.ItemContainerStyle>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <TextBlock
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Text="{Binding PageName}"
                                        ToolTip="{Binding PageName}"
                                        Visibility="{Binding IsEditing, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <!--  这里加这个只是为了解决hc首次编辑的时候不显示textbox里面的内容的问题，没有其他作用  -->
                                    <Label
                                        Width="100"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Content=""
                                        IsHitTestVisible="False" />
                                    <TextBox
                                        Background="White"
                                        BorderThickness="0"
                                        Foreground="Black"
                                        IsReadOnly="False"
                                        Text="{Binding EditingPageName, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding IsEditing, Converter={StaticResource Boolean2VisibilityConverter}}">
                                        <i:Interaction.Behaviors>
                                            <behaviors:CommitWriteDataPointPageEditBehavior />
                                        </i:Interaction.Behaviors>
                                    </TextBox>
                                </Grid>
                            </DataTemplate>
                        </hc:TabControl.ItemTemplate>
                        <hc:TabControl.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Border Background="{DynamicResource RegionBrush}" CornerRadius="6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Data.CurrentPageWriteDataPoints.Count, Source={StaticResource VmProxy}}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="48"
                                                Foreground="{DynamicResource BorderBrush}"
                                                Text="&#xE70F;" />
                                            <TextBlock
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="16"
                                                Foreground="{DynamicResource ThirdTextBrush}"
                                                Text="当前页面暂无写入点位" />
                                        </StackPanel>
                                    </Border>

                                    <DataGrid
                                        Margin="0"
                                        behaviors:DataGridSelectedItemsBehavior.SyncedSelectedItems="{Binding Data.SelectedWriteDataPoints, Source={StaticResource VmProxy}}"
                                        AllowDrop="True"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        DragOver="DataGrid_DragOver"
                                        Drop="DataGrid_Drop"
                                        HeadersVisibility="Column"
                                        ItemsSource="{Binding Data.CurrentPageWriteDataPoints, Source={StaticResource VmProxy}}"
                                        MouseMove="DataGrid_MouseMove"
                                        PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown"
                                        SelectedItem="{Binding Data.SelectedWriteDataPoint, Source={StaticResource VmProxy}, Mode=TwoWay}"
                                        SelectionMode="Extended"
                                        SelectionUnit="FullRow">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Command="{Binding Data.AddWriteDataPointCommand, Source={StaticResource VmProxy}}" Header="添加通道" />
                                                <MenuItem Command="{Binding Data.DeleteWriteDataPointCommand, Source={StaticResource VmProxy}}" Header="删除通道" />
                                                <MenuItem Command="{Binding Data.UpChannelCommand, Source={StaticResource VmProxy}}" Header="上移通道" />
                                                <MenuItem Command="{Binding Data.DownChannelCommand, Source={StaticResource VmProxy}}" Header="下移通道" />
                                                <MenuItem Header="移动页面">
                                                    <MenuItem.ItemsSource>
                                                        <Binding Path="Data.OtherPagesForSelectedChannel" Source="{StaticResource VmProxy}" />
                                                    </MenuItem.ItemsSource>
                                                    <MenuItem.ItemContainerStyle>
                                                        <Style BasedOn="{StaticResource MenuItemBaseStyle}" TargetType="MenuItem">
                                                            <Setter Property="Header" Value="{Binding PageName}" />
                                                            <Setter Property="Command" Value="{Binding Data.MoveChannelToPageCommand, Source={StaticResource VmProxy}}" />
                                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                                        </Style>
                                                    </MenuItem.ItemContainerStyle>
                                                </MenuItem>
                                                <MenuItem Header="批量移动页面">

                                                    <MenuItem Header="选中通道" ItemsSource="{Binding Data.TargetPagesForBatchEnableMove, Source={StaticResource VmProxy}}">
                                                        <MenuItem.ItemContainerStyle>
                                                            <Style BasedOn="{StaticResource MenuItemBaseStyle}" TargetType="MenuItem">
                                                                <Setter Property="Header" Value="{Binding PageName}" />

                                                                <Setter Property="Command" Value="{Binding Data.MoveSelectedChannelsCommand, Source={StaticResource VmProxy}}" />
                                                                <Setter Property="CommandParameter" Value="{Binding}" />
                                                            </Style>
                                                        </MenuItem.ItemContainerStyle>
                                                    </MenuItem>
                                                </MenuItem>
                                                <!--<MenuItem.ItemsSource>
                                                        <Binding Path="Data.BatchMoveChannelMenus" Source="{StaticResource VmProxy}" />
                                                    </MenuItem.ItemsSource>

                                                    <MenuItem.ItemContainerStyle>
                                                        <Style BasedOn="{StaticResource MenuItemBaseStyle}" TargetType="MenuItem">
                                                            <Setter Property="Header" Value="{Binding Header}" />
                                                            <Setter Property="ItemsSource" Value="{Binding Children}" />

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                                    <Setter Property="ItemsSource" Value="{x:Null}" />
                                                                    <Setter Property="Command" Value="{Binding Data.MoveBatchChannelsByMenuItemCommand, Source={StaticResource VmProxy}}" />
                                                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.ItemContainerStyle>-->

                                                <!--<MenuItem Header="批量移动通道">
                                                    <MenuItem.ItemsSource>
                                                        <Binding Path="Data.BatchMoveChannelMenus" Source="{StaticResource VmProxy}" />
                                                    </MenuItem.ItemsSource>
                                                    <MenuItem.ItemContainerStyle>
                                                        <Style BasedOn="{StaticResource MenuItemBaseStyle}" TargetType="MenuItem">
                                                            <Setter Property="Header" Value="{Binding Header}" />
                                                            <Setter Property="ItemsSource" Value="{Binding Children}" />
                                                            <Setter Property="Command" Value="{x:Null}" />
                                                            <Setter Property="CommandParameter" Value="{x:Null}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                                    <Setter Property="ItemsSource" Value="{x:Null}" />
                                                                    <Setter Property="Command" Value="{Binding Data.MoveBatchChannelsByMenuItemCommand, Source={StaticResource VmProxy}}" />
                                                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.ItemContainerStyle>
                                                </MenuItem>-->
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <i:Interaction.Behaviors>
                                            <behaviors:DataGridSelectAndScrollBehavior SelectedItem="{Binding Data.SelectedWriteDataPoint, Source={StaticResource VmProxy}}" />
                                        </i:Interaction.Behaviors>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="MouseDoubleClick">
                                                <i:InvokeCommandAction Command="{Binding Data.OpenWriteDataPointEditorCommand, Source={StaticResource VmProxy}}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="60"
                                                Binding="{Binding PageOrder, Mode=OneWay}"
                                                Header="序号"
                                                IsReadOnly="True" />
                                            <DataGridCheckBoxColumn
                                                Width="70"
                                                Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Header="启用"
                                                IsReadOnly="False" />
                                            <DataGridTextColumn
                                                Width="160"
                                                Binding="{Binding DisplayName, Mode=OneWay}"
                                                Header="名称"
                                                IsReadOnly="True" />
                                            <DataGridTextColumn
                                                Width="130"
                                                Binding="{Binding SelectedDeviceName, Mode=OneWay}"
                                                Header="设备"
                                                IsReadOnly="True" />
                                            <DataGridTextColumn
                                                Width="180"
                                                Binding="{Binding SelectedPointName, Mode=OneWay}"
                                                Header="点位"
                                                IsReadOnly="True" />
                                            <DataGridTemplateColumn Width="240" Header="值/操作">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid>
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsValueEditing}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <ContentControl Visibility="{Binding IsLabelMode, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                                    <TextBlock VerticalAlignment="Center" Text="{Binding CurrentValueDisplayText}" />
                                                                </ContentControl>
                                                                <ContentControl Visibility="{Binding IsTextBoxMode, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                                    <Border
                                                                        Background="Transparent"
                                                                        Cursor="Hand"
                                                                        IsEnabled="{Binding IsWriteInteractionEnabled}"
                                                                        PreviewMouseLeftButtonDown="TextBoxValueBorder_PreviewMouseLeftButtonDown">
                                                                        <Border.ToolTip>
                                                                            <TextBlock Text="{Binding WriteRestrictionBlockedReason}" />
                                                                        </Border.ToolTip>
                                                                        <TextBlock VerticalAlignment="Center" Text="{Binding PendingWriteValueText}" />
                                                                    </Border>
                                                                </ContentControl>
                                                                <ContentControl Visibility="{Binding IsButtonMode, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ContentControl Visibility="{Binding IsButtonClickWriteMode, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                                            <Button
                                                                                MaxWidth="100"
                                                                                Margin="0,0,0,0"
                                                                                Padding="10,4"
                                                                                HorizontalContentAlignment="Left"
                                                                                Command="{Binding Data.SubmitButtonWriteCommand, Source={StaticResource VmProxy}}"
                                                                                CommandParameter="{Binding}"
                                                                                Content="{Binding ButtonDisplayText}"
                                                                                IsEnabled="{Binding IsWriteInteractionEnabled}"
                                                                                Style="{StaticResource ButtonDanger}">

                                                                                <Button.ToolTip>
                                                                                    <TextBlock Text="{Binding ButtonDisplayText}" />
                                                                                </Button.ToolTip>
                                                                                <Button.ContentTemplate>
                                                                                    <DataTemplate>
                                                                                        <TextBlock
                                                                                            Text="{Binding}"
                                                                                            TextTrimming="CharacterEllipsis"
                                                                                            ToolTip="{Binding}" />
                                                                                    </DataTemplate>
                                                                                </Button.ContentTemplate>
                                                                            </Button>
                                                                        </ContentControl>
                                                                        <ContentControl Visibility="{Binding IsButtonPressAndReleaseMode, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                                            <Button
                                                                                MaxWidth="100"
                                                                                Margin="0,0,0,0"
                                                                                Padding="10,4"
                                                                                HorizontalContentAlignment="Left"
                                                                                Content="{Binding ButtonDisplayText}"
                                                                                IsEnabled="{Binding IsWriteInteractionEnabled}"
                                                                                Style="{StaticResource ButtonDanger}">
                                                                                <i:Interaction.Triggers>
                                                                                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                                                                        <i:InvokeCommandAction Command="{Binding Data.SubmitButtonPressWriteCommand, Source={StaticResource VmProxy}}" CommandParameter="{Binding}" />
                                                                                    </i:EventTrigger>
                                                                                    <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                                                                        <i:InvokeCommandAction Command="{Binding Data.SubmitButtonReleaseWriteCommand, Source={StaticResource VmProxy}}" CommandParameter="{Binding}" />
                                                                                    </i:EventTrigger>
                                                                                </i:Interaction.Triggers>
                                                                                <Button.ToolTip>
                                                                                    <TextBlock Text="{Binding ButtonDisplayText}" />
                                                                                </Button.ToolTip>
                                                                                <Button.ContentTemplate>
                                                                                    <DataTemplate>
                                                                                        <TextBlock
                                                                                            Text="{Binding}"
                                                                                            TextTrimming="CharacterEllipsis"
                                                                                            ToolTip="{Binding}" />
                                                                                    </DataTemplate>
                                                                                </Button.ContentTemplate>
                                                                            </Button>
                                                                        </ContentControl>

                                                                    </StackPanel>
                                                                </ContentControl>
                                                            </Grid>
                                                            <StackPanel Grid.Row="1">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsValueEditing}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsButtonMode}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <TextBox
                                                                        Width="110"
                                                                        Margin="0,0,6,0"
                                                                        hc:InfoElement.Necessary="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.HasError)}"
                                                                        IsEnabled="{Binding IsWriteInteractionEnabled}"
                                                                        Style="{StaticResource TextBoxExtend}"
                                                                        Text="{Binding EditingWriteValueText, UpdateSourceTrigger=PropertyChanged, Delay=100, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                                                        ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors).CurrentItem.ErrorContent}">
                                                                        <TextBox.InputBindings>
                                                                            <KeyBinding
                                                                                Key="Enter"
                                                                                Command="{Binding Data.CommitRowValueEditCommand, Source={StaticResource VmProxy}}"
                                                                                CommandParameter="{Binding}" />
                                                                            <KeyBinding
                                                                                Key="Escape"
                                                                                Command="{Binding Data.CancelRowValueEditCommand, Source={StaticResource VmProxy}}"
                                                                                CommandParameter="{Binding}" />
                                                                        </TextBox.InputBindings>
                                                                    </TextBox>
                                                                    <Button
                                                                        Margin="0,0,6,0"
                                                                        Padding="10,4"
                                                                        Command="{Binding Data.CommitRowValueEditCommand, Source={StaticResource VmProxy}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="写入"
                                                                        IsEnabled="{Binding IsWriteInteractionEnabled}"
                                                                        Style="{StaticResource ButtonDanger}" />
                                                                    <Button
                                                                        Padding="10,4"
                                                                        Command="{Binding Data.CancelRowValueEditCommand, Source={StaticResource VmProxy}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="取消"
                                                                        Style="{StaticResource ButtonDefault}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn
                                                Width="180"
                                                Binding="{Binding EditorModeDisplayText, Mode=OneWay}"
                                                Header="写值方式"
                                                IsReadOnly="True" />
                                            <DataGridTextColumn
                                                Width="80"
                                                Binding="{Binding Unit, Mode=OneWay}"
                                                Header="单位"
                                                IsReadOnly="True" />
                                            <DataGridTextColumn
                                                MinWidth="200"
                                                Binding="{Binding DisplayDescription, Mode=OneWay}"
                                                Header="说明"
                                                IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </DataTemplate>
                        </hc:TabControl.ContentTemplate>
                    </hc:TabControl>
                </Grid>
            </Grid>


            <hc:Drawer
                Dock="Right"
                IsOpen="{Binding IsEditorOpen, Mode=TwoWay}"
                ShowMode="Cover">
                <Border
                    MinWidth="680"
                    MaxWidth="820"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    DataContext="{Binding Data, Source={StaticResource VmProxy}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="15,12"
                            Background="{DynamicResource PrimaryBrush}">
                            <Grid>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding DrawerTitle}" />
                                <Button
                                    HorizontalAlignment="Right"
                                    hc:IconElement.Geometry="{StaticResource DeleteFillCircleGeometry}"
                                    Command="hc:ControlCommands.Close"
                                    Foreground="White"
                                    Style="{StaticResource ButtonIcon}" />
                            </Grid>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Padding="15,10"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                <Button
                                    Width="{StaticResource FormButtonWidth}"
                                    Margin="0,0,10,0"
                                    Command="{Binding CancelEditCommand}"
                                    Content="取消"
                                    Style="{StaticResource ButtonDefault}" />
                                <Button
                                    Width="{StaticResource FormButtonWidth}"
                                    Command="{Binding SaveWriteDataPointCommand}"
                                    Content="保存"
                                    Style="{StaticResource ButtonSuccess}" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer
                            Grid.Row="2"
                            Margin="20"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding EditingWriteDataPoint}">
                                <TextBlock
                                    Margin="0,0,0,15"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Text="基础配置" />

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="名称：" />
                                    <TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="请输入写入点位名称"
                                        Style="{StaticResource TextBoxExtend}"
                                        Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="设备：" />
                                    <hc:ComboBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="选择设备"
                                        DisplayMemberPath="DeviceName"
                                        ItemContainerStyle="{StaticResource WriteDataPointComboBoxItemStyle}"
                                        ItemsSource="{Binding Data.EnabledPlcDevices, Source={StaticResource VmProxy}}"
                                        SelectedItem="{Binding RuntimeDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ComboBoxExtend}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="点位：" />
                                    <hc:ComboBox
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="选择点位"
                                        DisplayMemberPath="PointName"
                                        ItemContainerStyle="{StaticResource WriteDataPointComboBoxItemStyle}"
                                        ItemsSource="{Binding AvailableDataPoints}"
                                        SelectedItem="{Binding RuntimeDataPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ComboBoxExtend}" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="单位：" />
                                    <TextBox
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource TextBoxExtend}"
                                        Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
