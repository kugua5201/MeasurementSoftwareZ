<UserControl
    x:Class="MeasurementSoftware.UserControls.WriteDataPointUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
    xmlns:behaviors="clr-namespace:MeasurementSoftware.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helpers="clr-namespace:MeasurementSoftware.Helpers"
    xmlns:highlighting="clr-namespace:MeasurementSoftware.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <helpers:BindingProxy x:Key="VmProxy" Data="{Binding}" />
        <Style
            x:Key="WriteDataPointComboBoxItemStyle"
            BasedOn="{StaticResource ComboBoxItemBaseStyle}"
            TargetType="ComboBoxItem">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!--<Style
            x:Key="WriteDataPointValidationTextBoxStyle"
            BasedOn="{StaticResource TextBoxExtend}"
            TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <AdornedElementPlaceholder Grid.Column="0" VerticalAlignment="Top" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="Red"
                                Text="{Binding [0].ErrorContent}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>-->
    </UserControl.Resources>

    <hc:SimplePanel>
        <Grid Style="{StaticResource PageRootGrid}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PageToolbarBorder}">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Padding="15,6"
                            Command="{Binding AddWriteDataPointCommand}"
                            Content="添加点位"
                            Style="{StaticResource ButtonPrimary}" />
                        <Button
                            Margin="0,0,8,0"
                            Padding="15,6"
                            Command="{Binding DeleteWriteDataPointCommand}"
                            Content="删除点位"
                            Style="{StaticResource ButtonDanger}" />
                        <Button
                            Margin="0,0,8,0"
                            Padding="15,6"
                            Command="{Binding ResetWriteDataPointOrderCommand}"
                            Content="重新编号"
                            Style="{StaticResource ButtonPrimary}" />
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding UpChannelCommand}"
                            Content="上移点位"
                            Style="{StaticResource ButtonInfo}" />
                        <Button
                            Command="{Binding DownChannelCommand}"
                            Content="下移点位"
                            Style="{StaticResource ButtonSuccess}" />
                    </StackPanel>
                    <Button Command="{Binding SaveRecipeCommand}" Style="{StaticResource SaveRecipeButton}" />
                </Grid>
            </Border>


            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>



                <Grid Grid.Row="1">
                    <Border Background="{DynamicResource RegionBrush}" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WriteDataPoints.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WriteDataPoints.Count}" Value="1">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="48"
                                Foreground="{DynamicResource BorderBrush}"
                                Text="&#xE70F;" />
                            <TextBlock
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                FontSize="16"
                                Foreground="{DynamicResource ThirdTextBrush}"
                                Text="请先添加写入点位配置" />
                        </StackPanel>
                    </Border>

                    <DataGrid
                        Margin="12"
                        AllowDrop="True"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        DragOver="DataGrid_DragOver"
                        Drop="DataGrid_Drop"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding WriteDataPoints}"
                        MouseMove="DataGrid_MouseMove"
                        PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown"
                        SelectedItem="{Binding SelectedWriteDataPoint, Mode=TwoWay}"
                        SelectionMode="Single">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding AddWriteDataPointCommand}" Header="添加点位" />
                                <MenuItem Command="{Binding DeleteWriteDataPointCommand}" Header="删除点位" />
                                <MenuItem Command="{Binding ResetWriteDataPointOrderCommand}" Header="重新编号" />
                                <MenuItem Command="{Binding UpChannelCommand}" Header="上移点位" />
                                <MenuItem Command="{Binding DownChannelCommand}" Header="下移点位" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="MouseDoubleClick">
                                <i:InvokeCommandAction Command="{Binding OpenWriteDataPointEditorCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="60"
                                Binding="{Binding Index, Mode=OneWay}"
                                Header="ID"
                                IsReadOnly="True" />
                            <DataGridCheckBoxColumn
                                Width="70"
                                Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Header="启用"
                                IsReadOnly="False" />
                            <DataGridTextColumn
                                Width="160"
                                Binding="{Binding DisplayName, Mode=OneWay}"
                                Header="名称"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding SelectedDeviceName, Mode=OneWay}"
                                Header="设备"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="180"
                                Binding="{Binding SelectedPointName, Mode=OneWay}"
                                Header="点位"
                                IsReadOnly="True" />
                            <DataGridTemplateColumn Width="240" Header="值/操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsValueEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <ContentControl Visibility="{Binding IsLabelMode, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding CurrentValueDisplayText}" />
                                                </ContentControl>
                                                <ContentControl Visibility="{Binding IsTextBoxMode, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                    <Border
                                                        Background="Transparent"
                                                        Cursor="Hand"
                                                        PreviewMouseLeftButtonDown="TextBoxValueBorder_PreviewMouseLeftButtonDown">
                                                        <TextBlock VerticalAlignment="Center" Text="{Binding PendingWriteValueText}" />
                                                    </Border>
                                                </ContentControl>
                                                <ContentControl Visibility="{Binding IsButtonMode, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ContentControl Visibility="{Binding IsButtonClickWriteMode, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                            <Button
                                                                MaxWidth="100"
                                                                Margin="0,0,0,0"
                                                                Padding="10,4"
                                                                HorizontalContentAlignment="Left"
                                                                Command="{Binding Data.SubmitButtonWriteCommand, Source={StaticResource VmProxy}}"
                                                                CommandParameter="{Binding}"
                                                                Content="{Binding ButtonDisplayText}"
                                                                Style="{StaticResource ButtonDefault}">

                                                                <Button.ToolTip>
                                                                    <TextBlock Text="{Binding ButtonDisplayText}" />
                                                                </Button.ToolTip>
                                                                <Button.ContentTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock
                                                                            Text="{Binding}"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            ToolTip="{Binding}" />
                                                                    </DataTemplate>
                                                                </Button.ContentTemplate>
                                                            </Button>
                                                        </ContentControl>
                                                        <ContentControl Visibility="{Binding IsButtonPressAndReleaseMode, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                            <Button
                                                                MaxWidth="100"
                                                                Margin="0,0,0,0"
                                                                Padding="10,4"
                                                                HorizontalContentAlignment="Left"
                                                                Content="{Binding ButtonDisplayText}"
                                                                Style="{StaticResource ButtonDefault}">
                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                                                        <i:InvokeCommandAction Command="{Binding Data.SubmitButtonPressWriteCommand, Source={StaticResource VmProxy}}" CommandParameter="{Binding}" />
                                                                    </i:EventTrigger>
                                                                    <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                                                        <i:InvokeCommandAction Command="{Binding Data.SubmitButtonReleaseWriteCommand, Source={StaticResource VmProxy}}" CommandParameter="{Binding}" />
                                                                    </i:EventTrigger>
                                                                </i:Interaction.Triggers>
                                                                <Button.ToolTip>
                                                                    <TextBlock Text="{Binding ButtonDisplayText}" />
                                                                </Button.ToolTip>
                                                                <Button.ContentTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock
                                                                            Text="{Binding}"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            ToolTip="{Binding}" />
                                                                    </DataTemplate>
                                                                </Button.ContentTemplate>
                                                            </Button>
                                                        </ContentControl>

                                                    </StackPanel>
                                                </ContentControl>
                                            </Grid>
                                            <StackPanel Grid.Row="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsValueEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsButtonMode}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBox
                                                        Width="110"
                                                        Margin="0,0,6,0"
                                                        hc:InfoElement.Necessary="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.HasError)}"
                                                        Style="{StaticResource TextBoxExtend}"
                                                        Text="{Binding EditingWriteValueText, UpdateSourceTrigger=PropertyChanged, Delay=100, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                                        ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors).CurrentItem.ErrorContent}">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding
                                                                Key="Enter"
                                                                Command="{Binding Data.CommitRowValueEditCommand, Source={StaticResource VmProxy}}"
                                                                CommandParameter="{Binding}" />
                                                            <KeyBinding
                                                                Key="Escape"
                                                                Command="{Binding Data.CancelRowValueEditCommand, Source={StaticResource VmProxy}}"
                                                                CommandParameter="{Binding}" />
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <Button
                                                        Margin="0,0,6,0"
                                                        Padding="10,4"
                                                        Command="{Binding Data.CommitRowValueEditCommand, Source={StaticResource VmProxy}}"
                                                        CommandParameter="{Binding}"
                                                        Content="写入"
                                                        Style="{StaticResource ButtonDanger}" />
                                                    <Button
                                                        Padding="10,4"
                                                        Command="{Binding Data.CancelRowValueEditCommand, Source={StaticResource VmProxy}}"
                                                        CommandParameter="{Binding}"
                                                        Content="取消"
                                                        Style="{StaticResource ButtonDefault}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="180"
                                Binding="{Binding EditorModeDisplayText, Mode=OneWay}"
                                Header="写值方式"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Unit, Mode=OneWay}"
                                Header="单位"
                                IsReadOnly="True" />
                            <!--<DataGridTextColumn
                                MinWidth="200"
                                Binding="{Binding DisplayDescription, Mode=OneWay}"
                                Header="说明"
                                IsReadOnly="True" />-->
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>


            <hc:Drawer
                Dock="Right"
                IsOpen="{Binding IsEditorOpen, Mode=TwoWay}"
                ShowMode="Cover">
                <Border
                    MinWidth="680"
                    MaxWidth="820"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    DataContext="{Binding Data, Source={StaticResource VmProxy}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="15,12"
                            Background="{DynamicResource PrimaryBrush}">
                            <Grid>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding DrawerTitle}" />
                                <Button
                                    HorizontalAlignment="Right"
                                    hc:IconElement.Geometry="{StaticResource DeleteFillCircleGeometry}"
                                    Command="hc:ControlCommands.Close"
                                    Foreground="White"
                                    Style="{StaticResource ButtonIcon}" />
                            </Grid>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Padding="15,10"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                <Button
                                    Width="{StaticResource FormButtonWidth}"
                                    Margin="0,0,10,0"
                                    Command="{Binding CancelEditCommand}"
                                    Content="取消"
                                    Style="{StaticResource ButtonDefault}" />
                                <Button
                                    Width="{StaticResource FormButtonWidth}"
                                    Command="{Binding SaveWriteDataPointCommand}"
                                    Content="保存"
                                    Style="{StaticResource ButtonSuccess}" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer
                            Grid.Row="2"
                            Margin="20"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding EditingWriteDataPoint}">
                                <TextBlock
                                    Margin="0,0,0,15"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Text="基础配置" />

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="名称：" />
                                    <TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="请输入写入点位名称"
                                        Style="{StaticResource TextBoxExtend}"
                                        Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="设备：" />
                                    <hc:ComboBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="选择设备"
                                        DisplayMemberPath="DeviceName"
                                        ItemContainerStyle="{StaticResource WriteDataPointComboBoxItemStyle}"
                                        ItemsSource="{Binding Data.EnabledPlcDevices, Source={StaticResource VmProxy}}"
                                        SelectedItem="{Binding RuntimeDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ComboBoxExtend}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="点位：" />
                                    <hc:ComboBox
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="选择点位"
                                        DisplayMemberPath="PointName"
                                        ItemContainerStyle="{StaticResource WriteDataPointComboBoxItemStyle}"
                                        ItemsSource="{Binding AvailableDataPoints}"
                                        SelectedItem="{Binding RuntimeDataPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ComboBoxExtend}" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="单位：" />
                                    <TextBox
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource TextBoxExtend}"
                                        Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="说明：" />
                                    <TextBox
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource TextBoxExtend}"
                                        Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="启用：" />
                                    <ToggleButton
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        IsChecked="{Binding IsEnabled}"
                                        Style="{StaticResource ToggleButtonSwitch}" />
                                </Grid>

                                <Separator Margin="0,5,0,15" />

                                <TextBlock
                                    Margin="0,0,0,15"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource WarningBrush}"
                                    Text="显示风格设置" />

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="值模式：" />
                                    <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        ItemContainerStyle="{StaticResource WriteDataPointComboBoxItemStyle}"
                                        ItemsSource="{Binding Data.EditorModes, Source={StaticResource VmProxy}}"
                                        SelectedItem="{Binding EditorMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ComboBoxExtend}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="标签显示："
                                        Visibility="{Binding EditorMode, Converter={StaticResource WriteDataPointEditorModeVisibilityConverter}, ConverterParameter=Label}" />
                                    <ComboBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        ItemContainerStyle="{StaticResource WriteDataPointComboBoxItemStyle}"
                                        ItemsSource="{Binding Data.LabelDisplayModes, Source={StaticResource VmProxy}}"
                                        SelectedItem="{Binding LabelDisplayMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ComboBoxExtend}"
                                        Visibility="{Binding EditorMode, Converter={StaticResource WriteDataPointEditorModeVisibilityConverter}, ConverterParameter=Label}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>


                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="0,4,0,0"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Text="Label 模式下可选原值显示或规则显示；TextBox 模式与 Button 模式不启用规则显示。">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EditorMode}" Value="Label">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EditorMode}" Value="TextBox">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EditorMode}" Value="Button">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Margin="0,8,0,8"
                                        VerticalAlignment="Center"
                                        Text="按钮文本："
                                        Visibility="{Binding EditorMode, Converter={StaticResource WriteDataPointEditorModeVisibilityConverter}, ConverterParameter=Button}" />
                                    <TextBox
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,8,0,8"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="请输入按钮显示文本"
                                        Style="{StaticResource TextBoxExtend}"
                                        Text="{Binding ButtonDisplayText, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding EditorMode, Converter={StaticResource WriteDataPointEditorModeVisibilityConverter}, ConverterParameter=Button}" />

                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="按钮动作："
                                        Visibility="{Binding EditorMode, Converter={StaticResource WriteDataPointEditorModeVisibilityConverter}, ConverterParameter=Button}" />
                                    <ComboBox
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        ItemContainerStyle="{StaticResource WriteDataPointComboBoxItemStyle}"
                                        ItemsSource="{Binding Data.ButtonInteractionModes, Source={StaticResource VmProxy}}"
                                        SelectedItem="{Binding ButtonInteractionMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ComboBoxExtend}"
                                        Visibility="{Binding EditorMode, Converter={StaticResource WriteDataPointEditorModeVisibilityConverter}, ConverterParameter=Button}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="{Binding ButtonPrimaryValueLabel}"
                                        Visibility="{Binding EditorMode, Converter={StaticResource WriteDataPointEditorModeVisibilityConverter}, ConverterParameter=Button}" />
                                    <TextBox
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Necessary="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.HasError)}"
                                        hc:InfoElement.Placeholder="{Binding ButtonPrimaryValuePlaceholder}"
                                        Style="{StaticResource WriteDataPointValidationTextBoxStyle}"
                                        Text="{Binding ButtonWriteValueText, UpdateSourceTrigger=PropertyChanged, Delay=100, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                        ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors).CurrentItem.ErrorContent}"
                                        Visibility="{Binding EditorMode, Converter={StaticResource WriteDataPointEditorModeVisibilityConverter}, ConverterParameter=Button}" />

                                    <TextBlock
                                        Grid.Row="7"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="松开值："
                                        Visibility="{Binding IsButtonPressAndReleaseMode, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                    <TextBox
                                        Grid.Row="7"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Necessary="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.HasError)}"
                                        hc:InfoElement.Placeholder="{Binding ButtonReleaseValuePlaceholder}"
                                        Style="{StaticResource WriteDataPointValidationTextBoxStyle}"
                                        Text="{Binding ButtonReleaseWriteValueText, UpdateSourceTrigger=PropertyChanged, Delay=100, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                        ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors).CurrentItem.ErrorContent}"
                                        Visibility="{Binding IsButtonPressAndReleaseMode, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                </Grid>

                                <StackPanel Margin="0,0,0,0" Visibility="{Binding UsesRuleDisplay, Converter={StaticResource Boolean2VisibilityConverter}}">
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource WarningBrush}"
                                        Text="规则编辑器" />
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="每行一个规则，格式：表达式=显示值；每行只支持一个条件。" />
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="可使用精确值或 &gt;、&lt;、&gt;=、&lt;= 比较，例如 &gt;=10；并且必须存在且只能存在一条 default=未命中显示文本。" />
                                    <Border
                                        Margin="0,10,0,0"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <avalonedit:TextEditor
                                            Height="100"
                                            Loaded="IndirectFormulaEditorTextBox_Loaded"
                                            ShowLineNumbers="True">
                                            <i:Interaction.Behaviors>
                                                <behaviors:AvalonEditTextBindingBehavior Text="{Binding RuleScriptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </i:Interaction.Behaviors>
                                        </avalonedit:TextEditor>
                                    </Border>
                                    <TextBlock Margin="0,8,0,0" Text="{Binding RuleScriptStatusText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RuleScriptStatusText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RuleScriptStatusText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RuleScriptStatusText}" Value=" ">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRuleScriptValid}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </hc:Drawer>
        </Grid>
    </hc:SimplePanel>
</UserControl>