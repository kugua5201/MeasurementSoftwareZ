<UserControl
    x:Class="MeasurementSoftware.UserControls.LogViewerUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <Grid Style="{StaticResource PageRootGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶部工具栏  -->
        <Border Grid.Row="0" Style="{StaticResource PageToolbarBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  第一行：日期选择和快捷按钮  -->
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,0"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="日期：" />
                    <DatePicker
                        Width="{StaticResource FormNumericWidth}"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        SelectedDate="{Binding SelectedDate}" />

                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="级别：" />
                    <ComboBox
                        Width="{StaticResource FormButtonWidth}"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding LogLevels}"
                        SelectedItem="{Binding SelectedLevel}"
                        Style="{StaticResource ComboBoxExtend}" />

                    <TextBlock
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="{Binding StatusMessage}" />

                    <Button
                        Margin="0,0,8,0"
                        Padding="15,6"
                        Command="{Binding RefreshCommand}"
                        Content="刷新"
                        Style="{StaticResource ButtonSuccess}" />
                    <Button
                        Padding="15,6"
                        Command="{Binding ClearLogsCommand}"
                        Content="清空"
                        Style="{StaticResource ButtonDanger}" />
                </StackPanel>

                <!--  第二行：状态栏  -->
            </Grid>
        </Border>

        <!--  日志列表  -->
        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            Background="White"
            BorderBrush="{StaticResource LightBorderBrush}"
            BorderThickness="0"
            FontSize="12"
            GridLinesVisibility="None"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding DisplayedLogs}"
            RowHeight="32"
            SelectionMode="Single">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Command="{Binding CopyLogCommand}"
                        CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                        Header="复制日志" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding Id}"
                    Header="ID">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource PlaceholderTextBrush}" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn
                    Width="180"
                    Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}"
                    Header="时间">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding Level}"
                    Header="级别">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                    <Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="WARN">
                                    <Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="INFO">
                                    <Setter Property="Foreground" Value="{StaticResource StatusInfoBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="DEBUG">
                                    <Setter Property="Foreground" Value="{StaticResource StatusDebugBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!--<DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource PlaceholderTextBrush}"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>-->
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Message}"
                    Header="消息">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="NoWrap" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding Message}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!--  分页控制（使用 HandyControl 分页）  -->
        <Border
            Grid.Row="2"
            Padding="15,10"
            Background="{StaticResource LightBackgroundBrush}"
            BorderBrush="{StaticResource LightBorderBrush}"
            BorderThickness="0,1,0,0">
            <hc:Pagination
                HorizontalAlignment="Right"
                DataCountPerPage="{Binding PageSize}"
                IsJumpEnabled="True"
                MaxPageCount="{Binding TotalPages}"
                PageIndex="{Binding CurrentPage, Mode=TwoWay}" />
        </Border>
    </Grid>
</UserControl>
