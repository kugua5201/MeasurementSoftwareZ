<UserControl
    x:Class="MeasurementSoftware.UserControls.CalibrationUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <Grid Style="{StaticResource PageRootGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶部操作栏  -->
        <Border Grid.Row="0" Style="{StaticResource PageToolbarBorder}">
            <Grid>

                <Button Command="{Binding SaveCalibrationCommand}" Style="{StaticResource SaveRecipeButton}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧：通道列表  -->
            <Border
                Grid.Column="0"
                Background="White"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Effect="{StaticResource EffectShadow1}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="12"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="6,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path
                                Width="16"
                                Height="16"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Data="M20,18H4V6H20M20,4H4A2,2 0 0,0 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6A2,2 0 0,0 20,4Z"
                                Fill="{DynamicResource PrimaryBrush}"
                                Stretch="Uniform" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="Bold"
                                Text="测量通道" />
                        </StackPanel>
                    </Border>

                    <ListBox
                        Grid.Row="1"
                        Margin="5"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Channels}"
                        SelectedItem="{Binding SelectedChannel}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,2"
                                    Padding="8,10"
                                    Background="Transparent"
                                    CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid
                                            Width="24"
                                            Height="24"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                            <Path
                                                Width="20"
                                                Height="20"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="M20,18H4V6H20M20,4H4A2,2 0 0,0 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6A2,2 0 0,0 20,4Z"
                                                Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{StaticResource StatusInfoBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RequiresCalibration}" Value="False">
                                                                <Setter Property="Fill" Value="{StaticResource DisabledIconBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>

                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Margin="0,0,-1,-1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Fill="{Binding RequiresCalibration, Converter={StaticResource Boolean2ColorConverter}}"
                                                Stroke="White"
                                                StrokeThickness="1.5" />
                                        </Grid>

                                        <StackPanel>
                                            <TextBlock FontSize="13" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding ChannelName}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RequiresCalibration}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Margin="0,4,0,0"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    CornerRadius="3">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource StatusSuccessBgBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RequiresCalibration}" Value="False">
                                                                    <Setter Property="Background" Value="{StaticResource StatusErrorBgBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="Medium">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="✓ 已启用" />
                                                                <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RequiresCalibration}" Value="False">
                                                                        <Setter Property="Text" Value="✗ 已停止" />
                                                                        <Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListBoxItemBaseStyle}" TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!--  右侧：校准操作区  -->
            <Border
                Grid.Column="2"
                Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Effect="{StaticResource EffectShadow1}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  标题栏  -->
                    <Border
                        Grid.Row="0"
                        Padding="12"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="6,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path
                                Width="18"
                                Height="18"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                Fill="{DynamicResource PrimaryBrush}"
                                Stretch="Uniform" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="Bold"
                                Text="通道校准" />
                        </StackPanel>
                    </Border>

                    <!--  内容区  -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15">
                            <!--  通道信息 + 校准方式（紧凑一行）  -->
                            <Border
                                Margin="0,0,0,8"
                                Padding="10,8"
                                Background="{DynamicResource BackgroundColor}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <!--<Path Data="M20,18H4V6H20M20,4H4A2,2 0 0,0 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6A2,2 0 0,0 20,4Z"
                                              Fill="{DynamicResource PrimaryBrush}"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center"/>-->
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            Text="{Binding SelectedChannel.ChannelName, FallbackValue='--'}" />
                                        <TextBlock Text="  " />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Text="A=" />
                                        <TextBlock
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            Text="{Binding SelectedChannel.CalibrationCoefficientA, StringFormat='{}{0:F5}', FallbackValue='--'}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Text="B=" />
                                        <TextBlock
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            Text="{Binding SelectedChannel.CalibrationCoefficientB, StringFormat='{}{0:F5}', FallbackValue='--'}" />
                                    </StackPanel>

                                    <ComboBox
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        ItemsSource="{Binding CalibrationModes}"
                                        SelectedItem="{Binding SelectedCalibrationMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ComboBoxExtend}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayTextConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!--  校准数据输入  -->
                            <Border
                                Margin="0,0,0,8"
                                Padding="10"
                                Background="{DynamicResource RegionBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{Binding IsSinglePointCalibration, Converter={StaticResource Boolean2VisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Text="标准值:" />
                                    <hc:NumericUpDown
                                        Width="{StaticResource FormNumericWidth}"
                                        Margin="0,0,12,0"
                                        DecimalPlaces="3"
                                        Value="{Binding SinglePointStandardValue}" />
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Text="测量值:" />
                                    <hc:NumericUpDown
                                        Width="{StaticResource FormNumericWidth}"
                                        Margin="0,0,12,0"
                                        DecimalPlaces="3"
                                        Value="{Binding SinglePointMeasuredValue}" />
                                    <Button
                                        Width="120"
                                        Command="{Binding ExecuteSinglePointCalibrationCommand}"
                                        Content="执行单点校准"
                                        Style="{StaticResource ButtonWarning}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Margin="0,0,0,8"
                                Padding="10"
                                Background="{DynamicResource RegionBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{Binding IsLeastSquaresCalibration, Converter={StaticResource Boolean2VisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel
                                        Grid.Row="0"
                                        Margin="0,0,0,8"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            Text="标准值:" />
                                        <hc:NumericUpDown
                                            Width="{StaticResource FormButtonWidth}"
                                            Margin="0,0,10,0"
                                            DecimalPlaces="3"
                                            Value="{Binding LeastSquaresStandardValue}" />
                                        <TextBlock
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            Text="测量值:" />
                                        <hc:NumericUpDown
                                            Width="{StaticResource FormButtonWidth}"
                                            Margin="0,0,10,0"
                                            DecimalPlaces="3"
                                            Value="{Binding LeastSquaresMeasuredValue}" />
                                        <Button
                                            Width="60"
                                            Height="28"
                                            Command="{Binding AddLeastSquaresCalibrationPointCommand}"
                                            Content="添加"
                                            Style="{StaticResource ButtonPrimary}" />
                                        <Button
                                            Width="60"
                                            Height="28"
                                            Margin="8,0,0,0"
                                            Command="{Binding RemoveLeastSquaresCalibrationPointCommand}"
                                            CommandParameter="{Binding SelectedLeastSquaresCalibrationPoint}"
                                            Content="删除"
                                            Style="{StaticResource ButtonDanger}" />
                                    </StackPanel>

                                    <DataGrid
                                        Grid.Row="1"
                                        MinHeight="120"
                                        MaxHeight="250"
                                        Margin="0,0,0,8"
                                        AutoGenerateColumns="False"
                                        Background="{StaticResource BackgroundColor}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CanUserAddRows="False"
                                        HeadersVisibility="Column"
                                        ItemsSource="{Binding LeastSquaresCalibrationPoints}"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        SelectedItem="{Binding SelectedLeastSquaresCalibrationPoint, Mode=TwoWay}"
                                        SelectionUnit="FullRow">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem
                                                    Command="{Binding RemoveLeastSquaresCalibrationPointCommand}"
                                                    CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Header="删除" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="40"
                                                Binding="{Binding Index}"
                                                Header="#"
                                                IsReadOnly="True" />
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding StandardValue, StringFormat=F3}"
                                                Header="标准值" />
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding MeasuredValue, StringFormat=F3}"
                                                Header="测量值" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Button
                                            Width="100"
                                            Margin="0,0,8,0"
                                            Command="{Binding ExecuteLeastSquaresCalibrationCommand}"
                                            Content="执行校准"
                                            Style="{StaticResource ButtonWarning}" />
                                        <Button
                                            Width="60"
                                            Command="{Binding ClearLeastSquaresCalibrationPointsCommand}"
                                            Content="清空"
                                            Style="{StaticResource ButtonDefault}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border
                                Margin="0,0,0,8"
                                Padding="10"
                                Background="{DynamicResource RegionBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{Binding IsLinearRegressionCalibration, Converter={StaticResource Boolean2VisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel
                                        Grid.Row="0"
                                        Margin="0,0,0,8"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            Text="标准值:" />
                                        <hc:NumericUpDown
                                            Width="{StaticResource FormButtonWidth}"
                                            Margin="0,0,10,0"
                                            DecimalPlaces="3"
                                            Value="{Binding LinearRegressionStandardValue}" />
                                        <TextBlock
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            Text="测量值:" />
                                        <hc:NumericUpDown
                                            Width="{StaticResource FormButtonWidth}"
                                            Margin="0,0,10,0"
                                            DecimalPlaces="3"
                                            Value="{Binding LinearRegressionMeasuredValue}" />
                                        <Button
                                            Width="60"
                                            Height="28"
                                            Command="{Binding AddLinearRegressionCalibrationPointCommand}"
                                            Content="添加"
                                            Style="{StaticResource ButtonPrimary}" />
                                        <Button
                                            Width="60"
                                            Height="28"
                                            Margin="8,0,0,0"
                                            Command="{Binding RemoveLinearRegressionCalibrationPointCommand}"
                                            CommandParameter="{Binding SelectedLinearRegressionCalibrationPoint}"
                                            Content="删除"
                                            Style="{StaticResource ButtonDanger}" />
                                    </StackPanel>

                                    <DataGrid
                                        Grid.Row="1"
                                        MinHeight="120"
                                        MaxHeight="250"
                                        Margin="0,0,0,8"
                                        AutoGenerateColumns="False"
                                        Background="{StaticResource BackgroundColor}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CanUserAddRows="False"
                                        HeadersVisibility="Column"
                                        ItemsSource="{Binding LinearRegressionCalibrationPoints}"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        SelectedItem="{Binding SelectedLinearRegressionCalibrationPoint, Mode=TwoWay}"
                                        SelectionUnit="FullRow">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem
                                                    Command="{Binding RemoveLinearRegressionCalibrationPointCommand}"
                                                    CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Header="删除" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="40"
                                                Binding="{Binding Index}"
                                                Header="#"
                                                IsReadOnly="True" />
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding StandardValue, StringFormat=F3}"
                                                Header="标准值" />
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding MeasuredValue, StringFormat=F3}"
                                                Header="测量值" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Button
                                            Width="100"
                                            Margin="0,0,8,0"
                                            Command="{Binding ExecuteLinearRegressionCalibrationCommand}"
                                            Content="执行校准"
                                            Style="{StaticResource ButtonWarning}" />
                                        <Button
                                            Width="60"
                                            Command="{Binding ClearLinearRegressionCalibrationPointsCommand}"
                                            Content="清空"
                                            Style="{StaticResource ButtonDefault}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border
                                Margin="0,0,0,8"
                                Padding="10"
                                Background="{DynamicResource RegionBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel
                                        Grid.Row="0"
                                        Margin="0,0,0,6"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource PrimaryBrush}"
                                            Text="校正历史" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Text="{Binding CalibrationHistory.Count, StringFormat='({0}条)'}" />
                                        <Button
                                            Width="50"
                                            Height="24"
                                            Margin="12,0,0,0"
                                            Command="{Binding ApplySelectedCalibrationHistoryCommand}"
                                            Content="回用"
                                            FontSize="11"
                                            Style="{StaticResource ButtonWarning}" />
                                        <Button
                                            Width="50"
                                            Height="24"
                                            Margin="8,0,0,0"
                                            Command="{Binding RefreshCalibrationHistoryCommand}"
                                            Content="刷新"
                                            FontSize="11"
                                            Style="{StaticResource ButtonPrimary}" />
                                        <Button
                                            Width="50"
                                            Height="24"
                                            Margin="8,0,0,0"
                                            Command="{Binding RemoveSelectedCalibrationHistoryCommand}"
                                            Content="删除"
                                            FontSize="11"
                                            Style="{StaticResource ButtonDanger}" />
                                    </StackPanel>

                                    <DataGrid
                                        Grid.Row="1"
                                        MinHeight="100"
                                        MaxHeight="350"
                                        AutoGenerateColumns="False"
                                        Background="{StaticResource BackgroundColor}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding CalibrationHistory}"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        SelectedItem="{Binding SelectedCalibrationHistory, Mode=TwoWay}"
                                        SelectionUnit="FullRow">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Command="{Binding ApplySelectedCalibrationHistoryCommand}" Header="回用" />
                                                <MenuItem Command="{Binding RemoveSelectedCalibrationHistoryCommand}" Header="删除" />
                                                <MenuItem Command="{Binding RefreshCalibrationHistoryCommand}" Header="刷新" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="150"
                                                Binding="{Binding CalibrationTime, StringFormat='yyyy-MM-dd HH:mm'}"
                                                Header="时间" />
                                            <DataGridTextColumn
                                                Width="90"
                                                Binding="{Binding MethodName}"
                                                Header="方式" />
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding CoefficientA, StringFormat=F5}"
                                                Header="A" />
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding CoefficientB, StringFormat=F5}"
                                                Header="B" />
                                            <DataGridTextColumn
                                                Width="50"
                                                Binding="{Binding CalibrationPoints.Count}"
                                                Header="点数" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  底部操作按钮  -->
                </Grid>
            </Border>
        </Grid>
    </Grid>

</UserControl>
