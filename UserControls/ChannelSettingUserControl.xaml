                                                    Style="{StaticResource ComboBoxBaseStyle}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Margin="0,0,0,8"
                                                    VerticalAlignment="Center"
                                                    Text="幅值：" />
                                                <hc:NumericUpDown
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Width="{StaticResource FormInputWidth}"
                                                    Margin="0,0,0,8"
                                                    HorizontalAlignment="Left"
                                                    Increment="1"
                                                    Minimum="0"
                                                    Value="{Binding EditingChannel.VirtualWaveformAmplitude, Mode=TwoWay}" />
                                                <TextBlock
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Margin="0,0,0,8"
                                                    VerticalAlignment="Center"
                                                    Text="偏移：" />
                                                <hc:NumericUpDown
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    Width="{StaticResource FormInputWidth}"
                                                    Margin="0,0,0,8"
                                                    HorizontalAlignment="Left"
                                                    Increment="1"
                                                    Value="{Binding EditingChannel.VirtualWaveformOffset, Mode=TwoWay}" />
                                                <TextBlock
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Text="周期(ms)：" />
                                                <hc:NumericUpDown
                                                    Grid.Row="3"
                                                    Grid.Column="1"
                                                    Width="{StaticResource FormInputWidth}"
                                                    HorizontalAlignment="Left"
                                                    Increment="10"
                                                    Minimum="1"
                                                    Value="{Binding EditingChannel.VirtualWaveformPeriodSeconds, Mode=TwoWay}" />
                                            </Grid>

                                            <Grid
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Margin="0,0,0,8">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding EditingChannel.VirtualSourceMode}" Value="{x:Static models:VirtualMeasurementSourceMode.SoftwareSimulation}" />
                                                                    <Condition Binding="{Binding EditingChannel.VirtualWaveformType}" Value="{x:Static models:VirtualMeasurementWaveformType.Square}" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Text="占空比：" />
                                                <hc:NumericUpDown
                                                    Grid.Column="1"
                                                    Width="{StaticResource FormInputWidth}"
                                                    HorizontalAlignment="Left"
                                                    Increment="0.1"
                                                    Maximum="0.999"
                                                    Minimum="0.001"
                                                    Value="{Binding EditingChannel.VirtualWaveformDutyCycle, Mode=TwoWay}" />
                                            </Grid>

                                            <Grid
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EditingChannel.VirtualSourceMode}" Value="{x:Static models:VirtualMeasurementSourceMode.ChannelFormula}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="200" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="200" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel
                                                    Grid.Row="0"
                                                    Margin="0,0,0,8"
                                                    Orientation="Horizontal">
                                                    <Button
                                                        Width="95"
                                                        Margin="0,0,8,0"
                                                        Command="{Binding AddVirtualSourceBindingCommand}"
                                                        Content="添加通道"
                                                        Style="{StaticResource ButtonPrimary}" />
                                                    <Button
                                                        Width="95"
                                                        Command="{Binding CheckVirtualFormulaCommand}"
                                                        Content="检查脚本"
                                                        Style="{StaticResource ButtonInfo}" />
                                                    <Button
                                                        Width="95"
                                                        Margin="8,0,0,0"
                                                        Click="OpenFormulaHelp_Click"
                                                        Content="函数说明"
                                                        Style="{StaticResource ButtonPrimary}"
                                                        Tag="Virtual" />
                                                </StackPanel>

                                                <Border
                                                    Grid.Row="1"
                                                    Margin="0,0,10,0"
                                                    Background="{DynamicResource RegionBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1">

                                                    <avalonedit:TextEditor
                                                        x:Name="VirtualFormulaEditorTextBox"
                                                        Grid.Row="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        FontFamily="Consolas"
                                                        FontSize="13"
                                                        HorizontalScrollBarVisibility="Auto"
                                                        Loaded="IndirectFormulaEditorTextBox_Loaded"
                                                        ShowLineNumbers="True"
                                                        SyntaxHighlighting="{x:Null}"
                                                        VerticalScrollBarVisibility="Auto">
                                                        <i:Interaction.Behaviors>
                                                            <behaviors:AvalonEditTextBindingBehavior Text="{Binding EditingChannel.VirtualFormula, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </i:Interaction.Behaviors>
                                                    </avalonedit:TextEditor>


                                                </Border>


                                                <TextBlock
                                                    Grid.Row="2"
                                                    Margin="0,6,0,8"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                    Text="*返回结果 RESULT = 表达式。" />

                                                <DataGrid
                                                    Grid.Row="3"
                                                    Margin="0,0,10,0"
                                                    AutoGenerateColumns="False"
                                                    CanUserAddRows="False"
                                                    HeadersVisibility="Column"
                                                    ItemsSource="{Binding EditingChannel.VirtualSourceBindings}"
                                                    RowHeaderWidth="0"
                                                    SelectedItem="{Binding SelectedVirtualSourceBinding, Mode=TwoWay}"
                                                    SelectionMode="Single"
                                                    SelectionUnit="FullRow">
                                                    <DataGrid.RowStyle>
                                                        <Style BasedOn="{StaticResource MeasurementDataGridRowStyle}" TargetType="DataGridRow">
                                                            <Setter Property="ContextMenu">
                                                                <Setter.Value>
                                                                    <ContextMenu>
                                                                        <ContextMenu.DataContext>
                                                                            <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource Self}" />
                                                                        </ContextMenu.DataContext>
                                                                        <MenuItem Command="{Binding Data.AddVirtualSourceBindingCommand, Source={StaticResource VmProxy}}" Header="添加通道" />
                                                                        <MenuItem
                                                                            Command="{Binding Data.RemoveVirtualSourceBindingCommand, Source={StaticResource VmProxy}}"
                                                                            CommandParameter="{Binding}"
                                                                            Header="删除" />
                                                                    </ContextMenu>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </DataGrid.RowStyle>
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn
                                                            Width="120"
                                                            Binding="{Binding SourceKey, UpdateSourceTrigger=PropertyChanged}"
                                                            Header="变量名" />
                                                        <DataGridTemplateColumn Width="220" Header="通道">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <ComboBox
                                                                        DisplayMemberPath="ChannelName"
                                                                        ItemsSource="{Binding Data.AvailableVirtualSourceChannels, Source={StaticResource VmProxy}}"
                                                                        SelectedItem="{Binding RuntimeChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                        Style="{StaticResource ComboBoxBaseStyle}" />
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn
                                                            Width="160"
                                                            Binding="{Binding SourceChannelName}"
                                                            Header="名称"
                                                            IsReadOnly="True" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Separator Margin="0,25,0,15" />

                                <TextBlock
                                    Margin="0,0,0,15"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource SuccessBrush}"
                                    Text="结果输出" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="输出结果：" />
                                    <StackPanel
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="0,0,0,8"
                                        Orientation="Horizontal">
                                        <ToggleButton
                                            HorizontalAlignment="Left"
                                            IsChecked="{Binding EditingChannel.EnableResultOutput, Mode=TwoWay}"
                                            Style="{StaticResource ToggleButtonSwitch}" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Text="启用后在测量完成时将当前通道 OK/NG 写入指定 PLC 点位" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="输出设备："
                                        Visibility="{Binding EditingChannel.EnableResultOutput, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                    <hc:ComboBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="选择输出设备"
                                        DisplayMemberPath="DeviceName"
                                        ItemsSource="{Binding EnabledPlcDevices}"
                                        SelectedItem="{Binding EditingChannel.ResultOutputRuntimeDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ComboBoxExtend}"
                                        Visibility="{Binding EditingChannel.EnableResultOutput, Converter={StaticResource Boolean2VisibilityConverter}}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,0,0,28"
                                        VerticalAlignment="Center"
                                        Text="输出点位："
                                        Visibility="{Binding EditingChannel.EnableResultOutput, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                    <StackPanel
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Visibility="{Binding EditingChannel.EnableResultOutput, Converter={StaticResource Boolean2VisibilityConverter}}">
                                        <hc:ComboBox
                                            Width="{StaticResource FormInputWidth}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Left"
                                            hc:InfoElement.Placeholder="选择输出点位"
                                            DisplayMemberPath="PointName"
                                            ItemsSource="{Binding EditingChannel.AvailableResultOutputDataPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedItem="{Binding EditingChannel.ResultOutputRuntimeDataPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ComboBoxExtend}" />
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            FontSize="11"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Text="Bool 点位默认写入 True / False；非 Bool 点位显示并可设置 OK / NG 值" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="OK值：">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding EditingChannel.EnableResultOutput}" Value="True" />
                                                            <Condition Binding="{Binding EditingChannel.IsResultOutputBoolDataPoint}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <hc:TextBox
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="请输入OK值"
                                        Text="{Binding EditingChannel.ResultOutputOkValue, UpdateSourceTrigger=PropertyChanged}">
                                        <hc:TextBox.Style>
                                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="hc:TextBox">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding EditingChannel.EnableResultOutput}" Value="True" />
                                                            <Condition Binding="{Binding EditingChannel.IsResultOutputBoolDataPoint}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </hc:TextBox.Style>
                                    </hc:TextBox>

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="NG值：">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding EditingChannel.EnableResultOutput}" Value="True" />
                                                            <Condition Binding="{Binding EditingChannel.IsResultOutputBoolDataPoint}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <hc:TextBox
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="请输入NG值"
                                        Text="{Binding EditingChannel.ResultOutputNgValue, UpdateSourceTrigger=PropertyChanged}">
                                        <hc:TextBox.Style>
                                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="hc:TextBox">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding EditingChannel.EnableResultOutput}" Value="True" />
                                                            <Condition Binding="{Binding EditingChannel.IsResultOutputBoolDataPoint}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </hc:TextBox.Style>
                                    </hc:TextBox>
                                </Grid>

                            </StackPanel>
                        </ScrollViewer>

                        <!--  底部操作按钮  -->
                        <Border
                            Grid.Row="1"
                            Padding="15,10"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                <Button
                                    Width="{StaticResource FormButtonWidth}"
                                    Margin="0,0,10,0"
                                    Command="{Binding CancelEditChannelCommand}"
                                    Content="取消"
                                    Style="{StaticResource ButtonDefault}" />
                                <Button
                                    Width="{StaticResource FormButtonWidth}"
                                    Command="{Binding SaveChannelCommand}"
                                    Content="保存"
                                    Style="{StaticResource ButtonSuccess}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </hc:Drawer>

        </Grid>
    </hc:SimplePanel>
</UserControl>
