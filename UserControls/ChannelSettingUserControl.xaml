                                                <Button
                                                    Width="95"
                                                    Margin="0,0,8,3"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding AddIndirectSourceBindingCommand}"
                                                    Content="添加数据源"
                                                    Style="{StaticResource ButtonPrimary}" />
                                                <Button
                                                    Width="95"
                                                    Margin="0,0,8,3"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding CheckIndirectFormulaCommand}"
