                                        Grid.Column="0"
                                        Grid.ColumnSpan="2">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EditingChannel.MeasurementMode}" Value="{x:Static models:MeasurementChannelMode.Indirect}">
