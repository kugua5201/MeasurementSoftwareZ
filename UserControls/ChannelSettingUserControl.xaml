                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EditingChannel.MeasurementMode}" Value="{x:Static models:MeasurementChannelMode.Direct}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EditingChannel.MeasurementMode}" Value="{x:Static models:MeasurementChannelMode.Indirect}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
