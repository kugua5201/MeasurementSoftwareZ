<UserControl
    x:Class="MeasurementSoftware.UserControls.ChannelSettingUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:MeasurementSoftware.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helpers="clr-namespace:MeasurementSoftware.Helpers"
    xmlns:local="clr-namespace:MeasurementSoftware.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="ChannelSettingControl"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <helpers:BindingProxy x:Key="VmProxy" Data="{Binding}" />
    </UserControl.Resources>
    <hc:SimplePanel>
        <Grid Style="{StaticResource PageRootGrid}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  主内容区域  -->
            <Grid
                x:Name="MainContentGrid"
                Grid.Row="0"
                Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="250" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.2*" MinWidth="350" />
                </Grid.ColumnDefinitions>

                <!--  左侧：产品图片 + 标注  -->
                <Border
                    x:Name="ImagePanel"
                    Grid.Column="0"
                    Padding="0"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding AddAnnotationAtPointCommand}" Header="在此添加标注" />
                            <MenuItem Command="{Binding ImportProductImageCommand}" Header="导入图片" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  图片区标题栏  -->
                        <Border Grid.Row="0" Style="{StaticResource PageToolbarBorder}">
                            <Grid>
                                <!--<TextBlock Text="产品图片 / 点位标注" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>-->
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <!--<Button Command="{Binding ImportProductImageCommand}"
                                            Content="导入图片"
                                            Style="{StaticResource ButtonPrimary}"
                                            Padding="12,5" Margin="0,0,8,0"/>
                                    <Button Command="{Binding DeleteAnnotationCommand}"
                                            Content="删除标注"
                                            Style="{StaticResource ButtonDanger}"
                                            Padding="12,5" Margin="0,0,8,0"/>-->
                                    <Button Command="{Binding SaveRecipeCommand}" Style="{StaticResource SaveRecipeButton}" />
                                    <hc:ContextMenuButton
                                        Margin="10,0,0,0"
                                        Padding="12,5"
                                        Content="更多 ▾"
                                        Style="{StaticResource ButtonInfo}"
                                        ToolTip="布局选项">
                                        <hc:ContextMenuButton.Menu>
                                            <ContextMenu>
                                                <MenuItem
                                                    x:Name="LayoutMenuItem"
                                                    Click="ToggleLayout_Click"
                                                    Header="切换为垂直布局" />
                                                <MenuItem Click="RestoreDefaultLayout_Click" Header="恢复默认布局" />
                                            </ContextMenu>
                                        </hc:ContextMenuButton.Menu>
                                    </hc:ContextMenuButton>

                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  图片显示区（支持右键标注 + 标注可拖动）  -->
                        <Grid
                            x:Name="ImageContainer"
                            Grid.Row="1"
                            ClipToBounds="True">

                            <!--  图片 + 同尺寸标注层叠加  -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

                                <Image
                                    x:Name="ProductImage"
                                    ContextMenu="{x:Null}"
                                    MouseRightButtonDown="ProductImage_MouseRightButtonDown"
                                    Source="{Binding ProductImagePath, Converter={StaticResource StringToImageSourceConverter}}"
                                    Stretch="Uniform">
                                    <!--<Image.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="在此添加标注" Command="{Binding AddAnnotationAtPointCommand}"/>
                                            <MenuItem Header="导入图片" Command="{Binding ImportProductImageCommand}"/>
                                        </ContextMenu>
                                    </Image.ContextMenu>-->
                                </Image>

                                <!--  标注点叠加层：可拖动  -->
                                <ItemsControl IsHitTestVisible="True" ItemsSource="{Binding Annotations}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource RelativeToPixelConverter}">
                                                        <Binding Path="X" />
                                                        <Binding ElementName="ProductImage" Path="ActualWidth" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Canvas.Top">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource RelativeToPixelConverter}">
                                                        <Binding Path="Y" />
                                                        <Binding ElementName="ProductImage" Path="ActualHeight" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <local:AnnotationMarkerControl
                                                Cursor="Hand"
                                                ForceDefaultColor="True"
                                                MouseLeftButtonDown="Annotation_MouseLeftButtonDown"
                                                MouseLeftButtonUp="Annotation_MouseLeftButtonUp"
                                                MouseMove="Annotation_MouseMove"
                                                MouseRightButtonDown="Annotation_MouseRightButtonDown"
                                                Recipe="{Binding DataContext.CurrentRecipe, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <local:AnnotationMarkerControl.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Click="DeleteAnnotationMenuItem_Click" Header="删除标注" />
                                                    </ContextMenu>
                                                </local:AnnotationMarkerControl.ContextMenu>
                                            </local:AnnotationMarkerControl>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!--  无图片遮罩  -->
                            <Border Background="{StaticResource LightBackgroundBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProductImagePath}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProductImagePath}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        HorizontalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="48"
                                        Foreground="{StaticResource DisabledIconBrush}"
                                        Text="&#xE8B9;" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{StaticResource DisabledTextBrush}"
                                        Text="右键导入产品图片" />


                                </StackPanel>

                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding ImportProductImageCommand}" Header="导入图片" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!--  可拖动分割条  -->
                <GridSplitter
                    x:Name="MainSplitter"
                    Grid.Column="1"
                    Width="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    Cursor="SizeWE"
                    DragCompleted="Splitter_DragCompleted"
                    ShowsPreview="True" />

                <!--  右侧：通道列表  -->
                <Border
                    x:Name="ChannelListPanel"
                    Grid.Column="2"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource PageToolbarBorder}">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,8,0"
                                        Padding="12,5"
                                        Command="{Binding AddChannelCommand}"
                                        Content="添加通道"
                                        Style="{StaticResource ButtonPrimary}"
                                        ToolTip="添加通道" />
                                    <Button
                                        Margin="0,0,8,0"
                                        Padding="12,5"
                                        Command="{Binding DeleteChannelCommand}"
                                        Content="删除通道"
                                        Style="{StaticResource ButtonDanger}"
                                        ToolTip="删除选中通道" />
                                    <Button
                                        Padding="12,5"
                                        Command="{Binding RenumberPointsCommand}"
                                        Content="重新编号"
                                        Style="{StaticResource ButtonPrimary}"
                                        ToolTip="重新排序通道编号" />
                                </StackPanel>

                            </Grid>
                        </Border>

                        <DataGrid
                            Grid.Row="1"
                            AlternationCount="2"
                            AutoGenerateColumns="False"
                            Background="{StaticResource BackgroundColor}"
                            CanUserAddRows="False"
                            CanUserResizeColumns="True"
                            ColumnHeaderStyle="{StaticResource ColoredHeaderStyle}"
                            FontSize="13"
                            HeadersVisibility="Column"
                            ItemsSource="{Binding Channels}"
                            MouseDoubleClick="DataGrid_MouseDoubleClick"
                            RowHeight="35"
                            RowStyle="{StaticResource MeasurementDataGridRowStyle}"
                            SelectedItem="{Binding SelectedChannel}"
                            SelectionMode="Single">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding AddChannelCommand}" Header="添加通道" />
                                    <MenuItem Command="{Binding DeleteChannelCommand}" Header="删除通道" />
                                    <MenuItem Command="{Binding RenumberPointsCommand}" Header="重新编号" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="60"
                                    Header="编号"
                                    IsReadOnly="True">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding Converter="{StaticResource ChannelDisplayTextConverter}">
                                            <Binding ElementName="ChannelSettingControl" Path="DataContext.CurrentRecipe.OtherSettings.ChannelDisplayPrefix" />
                                            <Binding Path="ChannelNumber" />
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding ChannelName}"
                                    Header="通道名称"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="50"
                                    Binding="{Binding StepNumber}"
                                    Header="工步"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding ChannelType}"
                                    Header="取值类型"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding MeasurementType}"
                                    Header="测量类型"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding PlcDeviceName}"
                                    Header="PLC设备"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding DataPointName}"
                                    Header="数据点位"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding DataSourceAddress}"
                                    Header="点位地址"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding StandardValue}"
                                    Header="标准值"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding UpperTolerance}"
                                    Header="上公差"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding LowerTolerance}"
                                    Header="下公差"
                                    IsReadOnly="True" />
                                <DataGridCheckBoxColumn
                                    Width="65"
                                    Binding="{Binding RequiresCalibration}"
                                    Header="校准"
                                    IsReadOnly="True" />
                                <DataGridCheckBoxColumn
                                    Width="50"
                                    Binding="{Binding IsEnabled}"
                                    Header="启用"
                                    IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!--  通道编辑抽屉  -->
            <hc:Drawer
                Dock="Right"
                IsOpen="{Binding IsChannelEditorOpen, Mode=TwoWay}"
                ShowMode="Cover"
                Tag="drawer">
                <Border
                    MinWidth="600"
                    MaxWidth="700"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    DataContext="{Binding Data, Source={StaticResource VmProxy}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  抽屉标题栏  -->
                        <Border
                            Grid.Row="0"
                            Padding="15,12"
                            Background="{DynamicResource PrimaryBrush}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{Binding DrawerTitle}" />
                                </StackPanel>
                                <Button
                                    HorizontalAlignment="Right"
                                    hc:IconElement.Geometry="{StaticResource DeleteFillCircleGeometry}"
                                    Command="hc:ControlCommands.Close"
                                    Foreground="White"
                                    Style="{StaticResource ButtonIcon}" />
                            </Grid>
                        </Border>

                        <!--  通道编辑表单  -->
                        <ScrollViewer
                            Grid.Row="2"
                            Margin="20"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,15"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Text="基本信息" />

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="通道编号：" />
                                    <TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        IsReadOnly="True"
                                        Style="{StaticResource TextBoxExtend}">
                                        <TextBox.Text>
                                            <MultiBinding Converter="{StaticResource ChannelDisplayTextConverter}">
                                                <Binding Path="CurrentRecipe.OtherSettings.ChannelDisplayPrefix" />
                                                <Binding Path="EditingChannel.ChannelNumber" />
                                            </MultiBinding>
                                        </TextBox.Text>
                                    </TextBox>

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="通道名称：" />
                                    <TextBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="请输入通道名称"
                                        Style="{StaticResource TextBoxExtend}"
                                        Text="{Binding EditingChannel.ChannelName, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="通道说明：" />
                                    <TextBox
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="请输入通道说明"
                                        Style="{StaticResource TextBoxExtend}"
                                        Text="{Binding EditingChannel.ChannelDescription, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="测量取值类型：" />
                                    <ComboBox
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        ItemsSource="{Binding ChannelTypes}"
                                        SelectedItem="{Binding EditingChannel.ChannelType}"
                                        Style="{StaticResource ComboBoxExtend}" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="测量类型：" />
                                    <TextBox
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="例如：直径、跳动、多段跳动"
                                        Style="{StaticResource TextBoxExtend}"
                                        Text="{Binding EditingChannel.MeasurementType, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="启用：" />
                                    <ToggleButton
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        IsChecked="{Binding EditingChannel.IsEnabled}"
                                        Style="{StaticResource ToggleButtonSwitch}" />
                                </Grid>

                                <Separator Margin="0,5,0,15" />

                                <TextBlock
                                    Margin="0,0,0,15"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource WarningBrush}"
                                    Text="工步配置" />

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="工步编号：" />
                                    <hc:NumericUpDown
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Maximum="{Binding CurrentRecipe.OtherSettings.TotalSteps, FallbackValue=99}"
                                        Minimum="1"
                                        Value="{Binding EditingChannel.StepNumber}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="工步名称：" />
                                    <TextBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="例如：第一步"
                                        Style="{StaticResource TextBoxExtend}"
                                        Text="{Binding EditingChannel.StepName, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <Separator Margin="0,5,0,15" />

                                <TextBlock
                                    Margin="0,0,0,15"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Text="测量参数" />

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="标准值：" />
                                    <TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource TextBoxExtend}"
                                        Text="{Binding EditingChannel.StandardValue}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="上公差：" />
                                    <TextBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource TextBoxExtend}"
                                        Text="{Binding EditingChannel.UpperTolerance}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="下公差：" />
                                    <TextBox
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource TextBoxExtend}"
                                        Text="{Binding EditingChannel.LowerTolerance}" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="单位：" />
                                    <TextBox
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="例如：mm"
                                        Style="{StaticResource TextBoxExtend}"
                                        Text="{Binding EditingChannel.Unit, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="采样数量：" />
                                    <hc:NumericUpDown
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Maximum="9999999"
                                        Minimum="1"
                                        Value="{Binding EditingChannel.SampleCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="校准：" />
                                    <ToggleButton
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        IsChecked="{Binding EditingChannel.RequiresCalibration, Mode=TwoWay}"
                                        Style="{StaticResource ToggleButtonSwitch}" />

                                    <TextBlock
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="小数位数：" />
                                    <hc:NumericUpDown
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        HorizontalAlignment="Left"
                                        Maximum="6"
                                        Minimum="0"
                                        Value="{Binding EditingChannel.DecimalPlaces}" />
                                </Grid>

                                <Separator Margin="0,5,0,15" />

                                <TextBlock
                                    Margin="0,0,0,15"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Text="数据源配置" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="PLC设备：" />
                                    <hc:ComboBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="选择设备"
                                        DisplayMemberPath="DeviceName"
                                        ItemsSource="{Binding EnabledPlcDevices}"
                                        SelectedItem="{Binding EditingChannel.RuntimeDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ComboBoxExtend}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="数据点位：" />
                                    <hc:ComboBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="选择数据点"
                                        DisplayMemberPath="PointName"
                                        ItemsSource="{Binding EditingChannel.AvailableDataPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedItem="{Binding EditingChannel.RuntimeDataPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ComboBoxExtend}" />

                                    <!--  使用缓存值开关：仅当选中的点位是缓存生成的时候显示  -->
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,8,0,0"
                                        VerticalAlignment="Center"
                                        Text="启用硬件缓存："
                                        Visibility="{Binding ShowCacheToggle, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                    <StackPanel
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,8,0,0"
                                        Orientation="Horizontal"
                                        Visibility="{Binding ShowCacheToggle, Converter={StaticResource Boolean2VisibilityConverter}}">
                                        <ToggleButton
                                            HorizontalAlignment="Left"
                                            IsChecked="{Binding EditingChannel.UseCacheValue, Mode=TwoWay}"
                                            Style="{StaticResource ToggleButtonSwitch}" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Text="开启后测量使用缓存解析值，关闭使用寄存器实时值" />
                                    </StackPanel>
                                </Grid>

                                <Separator Margin="0,25,0,15" />

                                <TextBlock
                                    Margin="0,0,0,15"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource SuccessBrush}"
                                    Text="结果输出" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="输出结果：" />
                                    <StackPanel
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="0,0,0,8"
                                        Orientation="Horizontal">
                                        <ToggleButton
                                            HorizontalAlignment="Left"
                                            IsChecked="{Binding EditingChannel.EnableResultOutput, Mode=TwoWay}"
                                            Style="{StaticResource ToggleButtonSwitch}" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Text="启用后在测量完成时将当前通道 OK/NG 写入指定 PLC 点位" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="输出设备："
                                        Visibility="{Binding EditingChannel.EnableResultOutput, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                    <hc:ComboBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="选择输出设备"
                                        DisplayMemberPath="DeviceName"
                                        ItemsSource="{Binding EnabledPlcDevices}"
                                        SelectedItem="{Binding EditingChannel.ResultOutputRuntimeDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ComboBoxExtend}"
                                        Visibility="{Binding EditingChannel.EnableResultOutput, Converter={StaticResource Boolean2VisibilityConverter}}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,0,0,20"
                                        VerticalAlignment="Center"
                                        Text="输出点位："
                                        Visibility="{Binding EditingChannel.EnableResultOutput, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                    <StackPanel
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Visibility="{Binding EditingChannel.EnableResultOutput, Converter={StaticResource Boolean2VisibilityConverter}}">
                                        <hc:ComboBox
                                            Width="{StaticResource FormInputWidth}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Left"
                                            hc:InfoElement.Placeholder="选择输出点位"
                                            DisplayMemberPath="PointName"
                                            ItemsSource="{Binding EditingChannel.AvailableResultOutputDataPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedItem="{Binding EditingChannel.ResultOutputRuntimeDataPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ComboBoxExtend}" />
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            FontSize="11"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Text="Bool 点位默认写入 True / False；非 Bool 点位显示并可设置 OK / NG 值" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Text="OK值：">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding EditingChannel.EnableResultOutput}" Value="True" />
                                                            <Condition Binding="{Binding EditingChannel.IsResultOutputBoolDataPoint}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <hc:TextBox
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="请输入OK值"
                                        Text="{Binding EditingChannel.ResultOutputOkValue, UpdateSourceTrigger=PropertyChanged}">
                                        <hc:TextBox.Style>
                                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="hc:TextBox">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding EditingChannel.EnableResultOutput}" Value="True" />
                                                            <Condition Binding="{Binding EditingChannel.IsResultOutputBoolDataPoint}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </hc:TextBox.Style>
                                    </hc:TextBox>

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="NG值：">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding EditingChannel.EnableResultOutput}" Value="True" />
                                                            <Condition Binding="{Binding EditingChannel.IsResultOutputBoolDataPoint}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <hc:TextBox
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Width="{StaticResource FormInputWidth}"
                                        HorizontalAlignment="Left"
                                        hc:InfoElement.Placeholder="请输入NG值"
                                        Text="{Binding EditingChannel.ResultOutputNgValue, UpdateSourceTrigger=PropertyChanged}">
                                        <hc:TextBox.Style>
                                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="hc:TextBox">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding EditingChannel.EnableResultOutput}" Value="True" />
                                                            <Condition Binding="{Binding EditingChannel.IsResultOutputBoolDataPoint}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </hc:TextBox.Style>
                                    </hc:TextBox>
                                </Grid>

                            </StackPanel>
                        </ScrollViewer>

                        <!--  底部操作按钮  -->
                        <Border
                            Grid.Row="1"
                            Padding="15,10"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                <Button
                                    Width="{StaticResource FormButtonWidth}"
                                    Margin="0,0,10,0"
                                    Command="{Binding CancelEditChannelCommand}"
                                    Content="取消"
                                    Style="{StaticResource ButtonDefault}" />
                                <Button
                                    Width="{StaticResource FormButtonWidth}"
                                    Command="{Binding SaveChannelCommand}"
                                    Content="保存"
                                    Style="{StaticResource ButtonSuccess}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </hc:Drawer>

        </Grid>
    </hc:SimplePanel>
</UserControl>
