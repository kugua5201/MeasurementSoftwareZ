<UserControl
    x:Class="MeasurementSoftware.UserControls.ZeroingUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <Grid Style="{StaticResource PageRootGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageToolbarBorder}">
            <Grid>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Width="{StaticResource FormLabelWidth}"
                            Margin="0,0,8,0"
                            Command="{Binding SelectAllChannelsCommand}"
                            Content="全选"
                            Style="{StaticResource ButtonPrimary}" />
                        <Button
                            Width="{StaticResource FormLabelWidth}"
                            Margin="0,0,8,0"
                            Command="{Binding ClearSelectionCommand}"
                            Content="取消全选"
                            Style="{StaticResource ButtonDefault}" />
                        <Button
                            Width="{StaticResource FormLabelWidth}"
                            Margin="0,0,8,0"
                            Command="{Binding ApplySelectedZeroCommand}"
                            Content="一键置零"
                            Style="{StaticResource ButtonSuccess}" />
                        <Button
                            Width="{StaticResource FormLabelWidth}"
                            Command="{Binding ClearSelectedZeroCommand}"
                            Content="清除置零"
                            Style="{StaticResource ButtonWarning}" />
                    </StackPanel>

                </StackPanel>
                <Button
                    HorizontalAlignment="Right"
                    Command="{Binding SaveRecipeCommand}"
                    Style="{StaticResource SaveRecipeButton}" />
            </Grid>
        </Border>

        <DataGrid
            Grid.Row="1"
            Margin="0,0,0,0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            ItemsSource="{Binding ChannelItems}"
            SelectedItem="{Binding SelectedChannelItem}">

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding SelectAllChannelsCommand}" Header="全选通道" />
                    <MenuItem Command="{Binding ClearSelectionCommand}" Header="取消全选" />
                    <MenuItem Command="{Binding ApplySelectedZeroCommand}" Header="开始置零" />
                    <MenuItem Command="{Binding ClearSelectedZeroCommand}" Header="清除置零" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn
                    Width="100"
                    Binding="{Binding IsZeroingSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Header="允许一键置零">
                    <DataGridCheckBoxColumn.ElementStyle>
                        <Style BasedOn="{StaticResource CheckBoxBaseStyle}" TargetType="CheckBox">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridCheckBoxColumn.ElementStyle>
                    <DataGridCheckBoxColumn.EditingElementStyle>
                        <Style BasedOn="{StaticResource CheckBoxBaseStyle}" TargetType="CheckBox">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridCheckBoxColumn.EditingElementStyle>
                </DataGridCheckBoxColumn>
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding ChannelNumber}"
                    Header="通道"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding ChannelName}"
                    Header="名称"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="110"
                    Binding="{Binding MeasuredValue}"
                    Header="原始值"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="110"
                    Binding="{Binding DisplayZeroOffsetValue}"
                    Header="置零触发值"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="110"
                    Binding="{Binding DisplayMeasuredValue}"
                    Header="置零后值"
                    IsReadOnly="True" />
                <DataGridTemplateColumn Width="100" Header="是否预设值">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsChecked="{Binding UsePresetZeroOffsetValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="130" Header="预设置零值">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <hc:NumericUpDown
                                IsEnabled="{Binding UsePresetZeroOffsetValue}"
                                Maximum="999999999"
                                Minimum="0"
                                Value="{Binding PresetZeroOffsetValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
